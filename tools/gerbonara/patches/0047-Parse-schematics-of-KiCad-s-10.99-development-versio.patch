+    length: Named(float) = None
+    width: Named(float) = None
+    stroke: Stroke = None
+
+
+@sexp_type('end_shape')
+class LineEnd(LineStart):
+    """ KiCad 10.99: decoration at the end of a line, polyline, arc or Bézier curve. """
+
+
