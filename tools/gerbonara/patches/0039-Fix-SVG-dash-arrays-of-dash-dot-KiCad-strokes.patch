From 5756ed8e8d46e2b9273bed0346fac6bf9527fd17 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:14:24 +0000
Subject: [PATCH 39/52] Fix SVG dash arrays of dash-dot KiCad strokes

The dash-dot patterns were missing the comma between dash and gap, and
strokes of width 0, which KiCad draws at its default width, got all-zero
dashes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/base_types.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/gerbonara/cad/kicad/base_types.py b/src/gerbonara/cad/kicad/base_types.py
index 3538603..95b0377 100644
--- a/src/gerbonara/cad/kicad/base_types.py
+++ b/src/gerbonara/cad/kicad/base_types.py
@@ -104,7 +104,7 @@ class Stroke:
             return default
     
     def svg_attrs(self, default_color=None):
-        w = self.width
+        w = self.width or 0.254
         if not (color := self.color or default_color):
             return {}
 
@@ -117,8 +117,8 @@ class Stroke:
             attrs['stroke_dasharray'] = {
                     Atom.dash: f'{w*5:.3f},{w*5:.3f}',
                     Atom.dot: f'{w*2:.3f},{w*2:.3f}',
-                    Atom.dash_dot: f'{w*5:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}',
-                    Atom.dash_dot_dot: f'{w*5:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}',
+                    Atom.dash_dot: f'{w*5:.3f},{w*3:.3f},{w:.3f},{w*3:.3f}',
+                    Atom.dash_dot_dot: f'{w*5:.3f},{w*3:.3f},{w:.3f},{w*3:.3f},{w:.3f},{w*3:.3f}',
                     }[self.type]
 
         return attrs
-- 
