{#- Dancing crystal: the crystal's box (x0, y0)-(x1, y1), centred on (cx, cy), tilted a little, with its arms
    up, a happy face, and music notes around it: `notes` [(x, y, size, colour, angle, glyph)]. #}
<path d="M{{ x0|f }} {{ (cy - 0.2)|f }}q-.7 -.3 -.9 -1.3M{{ x1|f }} {{ (cy - 0.2)|f }}q.6 -.6 1.3 -.5" fill="none" stroke="{{ INK }}" stroke-width=".24" stroke-linecap="round"/>
<circle cx="{{ (x0 - 0.9)|f }}" cy="{{ (cy - 1.5)|f }}" r=".2" fill="#fff" stroke="{{ INK }}" stroke-width=".12"/>
<circle cx="{{ (x1 + 1.35)|f }}" cy="{{ (cy - 0.7)|f }}" r=".2" fill="#fff" stroke="{{ INK }}" stroke-width=".12"/>
<g transform="rotate(-8 {{ cx|f }} {{ cy|f }})">
  <rect x="{{ x0|f }}" y="{{ y0|f }}" width="{{ (x1 - x0)|f }}" height="{{ (y1 - y0)|f }}" rx=".35" fill="#e6f7ff" stroke="{{ INK }}" stroke-width=".26"/>
  <path d="M{{ (x0 + 0.3)|f }} {{ (y0 + 0.3)|f }}l.5 .5" stroke="#fff" stroke-width=".25" stroke-linecap="round"/>
  <use href="#face-happy" transform="translate({{ cx|f }} {{ (cy - 0.2)|f }}) scale(.17)"/>
</g>
{% for x, y, size, col, angle, glyph in notes %}
<text x="{{ x|f }}" y="{{ y|f }}" font-size="{{ (size * 1.5)|f }}" font-family="DejaVu Sans, sans-serif" fill="{{ col }}" stroke="{{ INK }}" stroke-width=".12" paint-order="stroke" transform="rotate({{ angle }} {{ x|f }} {{ y|f }})">{{ glyph }}</text>
{% endfor %}
{% for s in (-1, 1) %}
<path d="M{{ (cx + s * 2.4)|f }} {{ (cy - 2.6)|f }}q{{ (s * 0.6)|f }} .5 {{ (s * 0.5)|f }} 1.2M{{ (cx + s * 2.9)|f }} {{ (cy - 2.1)|f }}q{{ (s * 0.45)|f }} .4 {{ (s * 0.35)|f }} .9" fill="none" stroke="#c9a0c2" stroke-width=".13" stroke-linecap="round"/>
{% endfor %}
