From 031046a0ee1fc66014d6d259a2f1f83acb6713e0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:09:12 +0000
Subject: [PATCH 22/41] Fix bounding boxes and SVG export of arcs in KiCad
 symbols

kicad_mid_to_center_arc() returns three values, but symbol arcs unpacked
two, and bounding_box() also used a variable before assigning it. The SVG
export always used sweep flag 0 and could never set the large arc flag.
Work out the direction and size of the arc from its three points once and
use that for both.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 35 ++++++++++++++----------------
 tests/test_kicad_symbols.py        | 13 +++++++++++
 2 files changed, 29 insertions(+), 19 deletions(-)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index c1faed3..ee62294 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -267,28 +267,25 @@ class Arc:
     stroke: Stroke = field(default_factory=Stroke)
     fill: Fill = field(default_factory=Fill)
 
-    def bounding_box(self, default=None):
-        (cx, cy), r = kicad_mid_to_center_arc(self.mid, self.start, self.end)
-        x1, y1 = self.start.x, self.start.y
-        x2, y2 = self.mid.x-x1, self.mid.y-x2
-        x3, y3 = (self.end.x - x1)/2, (self.end.y - y1)/2
-        clockwise = math.atan2(x2*y3-x3*y2, x2*x3+y2*y3) > 0
-        return arc_bounds(x1, y1, self.end.x, self.end.y, cx, cy, clockwise)
+    def _arc(self):
+        """ (center, radius, sweep flag, large arc flag): the sweep flag is set when the arc runs from start through
+        mid to end in the direction of increasing angle. """
+        (cx, cy), r, _ = kicad_mid_to_center_arc(self.mid, self.start, self.end)
+        s, m, e = self.start, self.mid, self.end
+        sweep = (m.x - s.x)*(e.y - s.y) - (m.y - s.y)*(e.x - s.x) > 0
+        a1, a2 = math.atan2(s.y - cy, s.x - cx), math.atan2(e.y - cy, e.x - cx)
+        span = (a2 - a1) % (2*math.pi) if sweep else (a1 - a2) % (2*math.pi)
+        return (cx, cy), r, sweep, span > math.pi
 
+    def bounding_box(self, default=None):
+        (cx, cy), _r, sweep, _large = self._arc()
+        # Symbol coordinates have the y axis pointing up like arc_bounds expects, so increasing angle means counter-
+        # clockwise.
+        return arc_bounds(self.start.x, self.start.y, self.end.x, self.end.y, cx, cy, not sweep)
 
     def to_svg(self, colorscheme=Colorscheme.KiCad):
-        (cx, cy), r = kicad_mid_to_center_arc(self.mid, self.start, self.end)
-
-        x1r = self.start.x - cx
-        y1r = self.start.y - cy
-        x2r = self.end.x - cx
-        y2r = self.end.y - cy
-        a1 = math.atan2(x1r, y1r)
-        a2 = math.atan2(x2r, y2r)
-        da = (a2 - a1 + math.pi) % (2*math.pi) - math.pi
-
-        large_arc = int(da > math.pi)
-        d = f'M {self.start.x:.3f} {self.start.y:.3f} A {r:.3f} {r:.3f} 0 {large_arc} 0 {self.end.x:.3f} {self.end.y:.3f}'
+        _c, r, sweep, large = self._arc()
+        d = f'M {self.start.x:.3f} {self.start.y:.3f} A {r:.3f} {r:.3f} 0 {int(large)} {int(sweep)} {self.end.x:.3f} {self.end.y:.3f}'
         yield Tag('path', d=d, fill=self.fill.svg(colorscheme.lines, colorscheme.fill),
                   **self.stroke.svg_attrs(colorscheme.lines))
 
diff --git a/tests/test_kicad_symbols.py b/tests/test_kicad_symbols.py
index 7a7af37..de50810 100644
--- a/tests/test_kicad_symbols.py
+++ b/tests/test_kicad_symbols.py
@@ -187,3 +187,16 @@ def test_polyline_and_rectangle_svg():
     rect, = unit.rectangles
     path, = rect.to_svg()
     assert path.attrs['d'].count('L') == 4
+
+
+@pytest.mark.parametrize('mid, bbox, flags', [((0, 1), ((-1, 0), (1, 1)), '0 1'), ((0, -1), ((-1, -1), (1, 0)), '0 0')])
+def test_symbol_arc(mid, bbox, flags):
+    lib = Library.parse(f'''(kicad_symbol_lib (version 20241209) (generator "kicad_symbol_editor")
+        (symbol "Arc" (in_bom yes) (on_board yes)
+            (symbol "Arc_1_1"
+                (arc (start 1 0) (mid {mid[0]} {mid[1]}) (end -1 0) (stroke (width 0.254) (type solid)) (fill (type none))))))''')
+    arc, = lib.symbols[0].units[0].arcs
+    (x1, y1), (x2, y2) = arc.bounding_box()
+    assert [round(v, 6) for v in (x1, y1, x2, y2)] == [*bbox[0], *bbox[1]]
+    path, = arc.to_svg()
+    assert path.attrs['d'] == f'M 1.000 0.000 A 1.000 1.000 0 {flags} -1.000 0.000'
