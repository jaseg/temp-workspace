// Level browser panel (levels.js).
diffEasy = #3cb371
diffNormal = #59b0f4
diffHard = #ff8c42
diffExpert = #e0475e
diffExpertPlus = #a66ff0
accent = #ff4fa3

#levelBrowser
  position fixed
  inset 0
  z-index 2147483000 // above the controls bar and its panels
  display flex
  flex-direction column
  background rgba(8, 10, 14, 0.94)
  color #e8ebef
  font 14px/1.4 'Segoe UI', system-ui, sans-serif

#levelBrowser[hidden]
  display none

#levelBrowser .lbHeader
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  width 100%
  max-width 960px
  margin 0 auto
  padding 12px 16px
  box-sizing border-box

#levelBrowser .lbTitle
  flex 1 1 auto
  margin 0
  font-size 20px
  font-weight 600
  white-space nowrap

#levelBrowser .lbCount
  color #8b93a0
  font-weight 400
  font-size 15px

#levelBrowser .lbSearch, #levelBrowser .lbSort
  height 34px
  padding 0 10px
  border 1px solid #2d333d
  border-radius 8px
  background #151920
  color inherit
  font inherit

#levelBrowser .lbSearch
  flex 1 1 220px
  min-width 0

#levelBrowser .lbClose
  width 34px
  height 34px
  border 0
  border-radius 8px
  background #232933
  color #fff
  font-size 22px
  line-height 1
  cursor pointer

#levelBrowser .lbStatus
  max-width 960px
  margin 0 auto
  padding 24px 16px
  color #8b93a0

#levelBrowser .lbStatus[hidden]
  display none

#levelBrowser .lbList
  flex 1 1 auto
  overflow-y auto
  width 100%
  max-width 960px
  margin 0 auto
  padding 0 16px 24px
  box-sizing border-box
  list-style none

#levelBrowser .lbLevel
  position relative
  display grid
  grid-template-columns 64px 1fr 44px
  gap 4px 12px
  align-items center
  padding 10px
  border-radius 10px
  cursor pointer
  overflow hidden

  &:hover, &.expanded
    background #151920

#levelBrowser .lbCover
  width 64px
  height 64px
  border-radius 6px
  background #232933
  overflow hidden

  img
    width 100%
    height 100%
    object-fit cover

  img[hidden]
    display none

#levelBrowser .lbMain
  min-width 0

#levelBrowser .lbName
  font-weight 600
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

#levelBrowser .lbSub
  color #8b93a0
  font-weight 400

#levelBrowser .lbMeta
  color #a3abb7
  font-size 13px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

#levelBrowser .lbChips
  display flex
  flex-wrap wrap
  gap 4px
  margin-top 4px

#levelBrowser .lbChip, #levelBrowser .lbBadge, #levelBrowser .lbMore
  padding 1px 7px
  border-radius 10px
  font-size 12px
  font-weight 600
  white-space nowrap

#levelBrowser .lbChip
  background #232933

#levelBrowser .lbMore
  color #8b93a0
  font-weight 400

#levelBrowser .lbStars
  font-weight 400

#levelBrowser .lbBadge
  color #111
  background #8b93a0

  &.status3
    background #f5c542

  &.status2
    background #9bd2ff

#levelBrowser .dEasy
  color diffEasy

#levelBrowser .dNormal
  color diffNormal

#levelBrowser .dHard
  color diffHard

#levelBrowser .dExpert
  color diffExpert

#levelBrowser .dExpertPlus
  color diffExpertPlus

#levelBrowser .lbPlay
  width 40px
  height 40px
  border 0
  border-radius 50%
  background accent
  cursor pointer
  position relative

  // Play triangle; a square while playing.
  &::before
    content ''
    position absolute
    left 15px
    top 12px
    border-style solid
    border-width 8px 0 8px 13px
    border-color transparent transparent transparent #fff

  &:disabled
    background #2d333d
    cursor default

#levelBrowser .lbLevel.playing .lbPlay::before
  left 13px
  top 13px
  width 14px
  height 14px
  border 0
  background #fff

#levelBrowser .lbLevel.loading .lbPlay
  animation lbPulse 0.8s ease-in-out infinite alternate

@keyframes lbPulse
  to
    opacity 0.4

#levelBrowser .lbProgress
  position absolute
  left 0
  bottom 0
  height 3px
  width 0
  background accent

#levelBrowser .lbDetails
  grid-column 1 / -1
  cursor default

#levelBrowser .lbDetails[hidden]
  display none

#levelBrowser .lbTableWrap
  overflow-x auto

#levelBrowser .lbTable
  border-collapse collapse
  width 100%
  font-size 13px
  font-variant-numeric tabular-nums
  white-space nowrap

  th, td
    padding 4px 8px
    text-align right
    border-bottom 1px solid #232933

  th:nth-child(-n+2), td:nth-child(-n+2)
    text-align left

  th
    color #8b93a0
    font-weight 400

#levelBrowser .lbNote
  margin-top 6px
  color #8b93a0
  font-size 12px

@media (max-width: 480px)
  #levelBrowser .lbLevel
    grid-template-columns 48px 1fr 40px
    padding 8px 4px

  #levelBrowser .lbCover
    width 48px
    height 48px
