From 87f0d6355308dde8a88980f13f873e79a73987f8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:08:14 +0000
Subject: [PATCH 01/52] Fix serializing KiCad schematics without symbol library

Schematic.lib_symbols defaulted to a plain list instead of a LocalLibrary,
so a schematic created from scratch or loaded from a file without a
(lib_symbols ...) section could not be serialized.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 4f487bd..12eac55 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -621,7 +621,7 @@ class Schematic:
     title_block: TitleBlock = None
     # The doc says this is expected, but eeschema barfs when it's there.
     # path: SheetPath = field(default_factory=SheetPath)
-    lib_symbols: LocalLibrary = field(default_factory=list)
+    lib_symbols: LocalLibrary = field(default_factory=LocalLibrary)
     junctions: List(Junction) = field(default_factory=list)
     no_connects: List(NoConnect) = field(default_factory=list)
     rule_areas: List(RuleArea) = field(default_factory=list)
-- 
