From 18b786ae4be7d64ac24c0461371ae099f8333cf4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:12:02 +0000
Subject: [PATCH 11/41] Parse KiCad 10 assembly variants of placed symbols and
 sheets

KiCad 10 stores per-variant overrides of the DNP, simulation, BOM, board
and position file attributes, and of field values, in the instance paths
of placed symbols and sheets.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 20 ++++++++++++++++++++
 tests/test_kicad_schematic.py        | 27 +++++++++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index f2baeac..a74cdf5 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -340,6 +340,24 @@ class Pin:
     alternate: Named(str) = None
 
 
+@sexp_type('field')
+class VariantField:
+    name: Named(str) = ''
+    value: Named(str) = ''
+
+
+@sexp_type('variant')
+class Variant:
+    """ KiCad 10 assembly variant of a placed symbol or sheet. Attributes that are None are inherited. """
+    name: Named(str) = ''
+    dnp: Named(YesNoAtom()) = None
+    exclude_from_sim: Named(YesNoAtom()) = None
+    in_bom: Named(YesNoAtom()) = None
+    on_board: Named(YesNoAtom()) = None
+    in_pos_files: Named(YesNoAtom()) = None
+    fields: List(VariantField) = field(default_factory=list)
+
+
 # Suddenly, we're doing syntax like this is yaml or something.
 @sexp_type('path')
 class SymbolCrosslinkSheet:
@@ -348,6 +366,7 @@ class SymbolCrosslinkSheet:
     unit: Named(int) = 1
     value: OmitDefault(Named(str)) = None
     footprint: OmitDefault(Named(str)) = None
+    variants: List(Variant) = field(default_factory=list)
 
 
 @sexp_type('project')
@@ -466,6 +485,7 @@ class SymbolInstance:
 class SubsheetCrosslinkSheet:
     path: str = ''
     page: Named(str) = ''
+    variants: List(Variant) = field(default_factory=list)
 
 
 @sexp_type('project')
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 74e2878..5cebdf3 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -134,3 +134,30 @@ def test_private_symbol_property():
     prop, = sch.symbols[0].properties
     assert (prop.private, prop.key, prop.value) == (True, 'KLC_S3.3', 'The rectangle is not a symbol body')
     assert '(property private "KLC_S3.3"' in sch.serialize()
+
+
+def test_symbol_variants():
+    sch = Schematic.parse('''(kicad_sch (version 20260306) (generator "eeschema")
+        (symbol (lib_id "Device:R") (at 10 10 0) (unit 1)
+            (instances
+                (project "variants"
+                    (path "/1234" (reference "R1") (unit 1)
+                        (variant (name "Variant 1") (dnp yes))
+                        (variant (name "Variant2") (in_bom no) (field (name "Value") (value "10K_V2"))))))))''')
+    path, = sch.symbols[0].instances[0].instances
+    v1, v2 = path.variants
+    assert (v1.name, v1.dnp, v1.in_bom) == ('Variant 1', True, None)
+    assert (v2.name, v2.dnp, v2.in_bom, [(f.name, f.value) for f in v2.fields]) == ('Variant2', None, False, [('Value', '10K_V2')])
+    path, = Schematic.parse(sch.serialize()).symbols[0].instances[0].instances
+    assert [v.name for v in path.variants] == ['Variant 1', 'Variant2']
+    assert path.variants[1].fields[0].value == '10K_V2'
+
+
+def test_subsheet_variants():
+    sch = Schematic.parse('''(kicad_sch (version 20260306) (generator "eeschema")
+        (sheet (at 10 10) (size 20 10)
+            (property "Sheetname" "foo" (at 10 9 0) (effects (font (size 1.27 1.27))))
+            (property "Sheetfile" "foo.kicad_sch" (at 10 21 0) (effects (font (size 1.27 1.27))))
+            (instances (project "a" (path "/1234" (page "2") (variant (name "Variant 1") (exclude_from_sim yes)))))))''')
+    path, = sch.subsheets[0].instances[0].instances
+    assert [(v.name, v.exclude_from_sim) for v in path.variants] == [('Variant 1', True)]
