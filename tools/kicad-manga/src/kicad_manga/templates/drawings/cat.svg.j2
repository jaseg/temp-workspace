{#- A curled-up sleeping cat, drawn 20 wide and scaled by `k`: fur `color`, a `patch` on its back. #}
{% from 'drawings/wrap.svg.j2' import wrap %}
{% call wrap() %}
<g transform="scale({{ k|f }})">
  <ellipse cx="0" cy=".2" rx="10" ry="1" fill="url(#tone-ink)" stroke="none" opacity=".35"/>
  <path d="M-9 0C-10 -6 -5 -9.5 1 -9 6 -8.5 9 -5 8.5 0Z" fill="{{ color }}"/>
  <path d="M-2 -8.8C1 -9.6 5 -8 6.5 -5 4 -6.5 0 -6.5 -2 -8.8Z" fill="{{ patch }}" stroke="none"/>
  <path d="M8.5 0C11 -.5 11.5 -3 9.5 -3.6" fill="none" stroke-width="1.6"/>
  <path d="M8.5 0C11 -.5 11.5 -3 9.5 -3.6" fill="none" stroke="{{ color }}" stroke-width="1"/>
  <path d="M-10.5 0C-11.5 -1.5 -11.4 -4.5 -10.5 -5.5L-10.2 -8.2 -8.3 -6.3C-7 -6.8 -5.6 -6.8 -4.3 -6.3L-2.6 -8 -2.3 -5.3C-1.3 -4 -1.5 -1 -2.5 0Z" fill="{{ color }}"/>
  <path d="M-9.9 -6.8l.2 -.9.8 .7zM-3.2 -6.7l.4 -.8.3 .9z" fill="#ffc2da" stroke="none"/>
  <path d="M-9 -3.2q.7 .6 1.4 0M-5.6 -3.2q.7 .6 1.4 0" fill="none" stroke-width=".32"/>
  <path d="M-6.9 -2.1l-.3 .3h.6z" fill="#ff9cc2" stroke-width=".2"/>
  <ellipse cx="-9.4" cy="-1.6" rx=".8" ry=".4" fill="#ff9cc2" stroke="none" opacity=".7"/>
  <ellipse cx="-3.8" cy="-1.6" rx=".8" ry=".4" fill="#ff9cc2" stroke="none" opacity=".7"/>
  <text x="-1" y="-11" font-family="{{ FONT_POP }}" font-size="2.6" fill="{{ LINE }}" stroke="none">z</text>
  <text x="1.4" y="-13" font-family="{{ FONT_POP }}" font-size="3.4" fill="{{ LINE }}" stroke="none">z</text>
</g>
{% endcall %}
