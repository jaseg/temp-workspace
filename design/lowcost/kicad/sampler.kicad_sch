  (hierarchical_label "STRB_A" (shape input) (at 38.1 83.82 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right)) (uuid 493bdf59-1c21-5418-8acf-e69e00f5cac2))
