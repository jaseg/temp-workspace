 src/gerbonara/cad/kicad/schematic.py  | 45 +++++++++++++++++++++++++++
 src/gerbonara/cad/kicad/symbols.py    | 11 ++-----
 3 files changed, 57 insertions(+), 9 deletions(-)

diff --git a/src/gerbonara/cad/kicad/primitives.py b/src/gerbonara/cad/kicad/primitives.py
index 8554d80..f6f6d95 100644
--- a/src/gerbonara/cad/kicad/primitives.py
+++ b/src/gerbonara/cad/kicad/primitives.py
@@ -86,6 +86,16 @@ def kicad_mid_to_center_arc(mid, start, end):
     return (cx, cy), radius, det < 0
 
 
+def kicad_arc_svg_flags(start, mid, end):
+    """ (center, radius, sweep flag, large arc flag) for drawing a KiCad start/mid/end arc as an SVG arc. The sweep
+    flag is set when the arc runs from start through mid to end in the direction of increasing angle. """
+    (cx, cy), r, _ = kicad_mid_to_center_arc(mid, start, end)
+    sweep = (mid.x - start.x)*(end.y - start.y) - (mid.y - start.y)*(end.x - start.x) > 0
+    a1, a2 = math.atan2(start.y - cy, start.x - cx), math.atan2(end.y - cy, end.x - cx)
+    span = (a2 - a1) % (2*math.pi) if sweep else (a1 - a2) % (2*math.pi)
+    return (cx, cy), r, sweep, span > math.pi
+
+
 @sexp_type('hatch')
 class Hatch:
     style: AtomChoice(Atom.none, Atom.edge, Atom.full) = Atom.edge
diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index f35f6ef..f40a448 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -110,6 +110,20 @@ def _polyline_svg(self, default_color):
     return da.svg(stroke=self.stroke.svg_color(default_color))
 
 
+def _fill_svg(fill, colorscheme):
+    if fill is None or fill.type == Atom.none:
+        return 'none'
+    elif fill.type == Atom.outline:
+        return colorscheme.lines
+    elif fill.type == Atom.color and fill.color:
+        return fill.color.svg(colorscheme.fill)
+    return colorscheme.fill
+
+
+def _shape_svg(self, colorscheme, name='path', **attrs):
+    return Tag(name, **attrs, fill=_fill_svg(self.fill, colorscheme), **self.stroke.svg_attrs(colorscheme.lines))
+
+
 def _polyline_bounds(self):
     x1 = min(pt.x for pt in self.points)
     y1 = min(pt.y for pt in self.points)
@@ -168,6 +182,10 @@ class Circle:
     fill: OmitDefault(Fill) = None
     uuid: UUID = field(default_factory=UUID)
 
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        yield _shape_svg(self, colorscheme, 'circle', cx=f'{self.center.x:.3f}', cy=f'{self.center.y:.3f}',
+                         r=f'{self.radius:.3f}')
+
 
 @sexp_type('rectangle')
 class Rectangle:
@@ -177,6 +195,10 @@ class Rectangle:
     fill: OmitDefault(Fill) = None
     uuid: UUID = field(default_factory=UUID)
 
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        x1, y1, x2, y2 = self.start.x, self.start.y, self.end.x, self.end.y
+        yield _shape_svg(self, colorscheme, d=f'M {x1:.3f} {y1:.3f} H {x2:.3f} V {y2:.3f} H {x1:.3f} Z')
+
 
 @sexp_type('arc')
 class Arc:
@@ -187,6 +209,11 @@ class Arc:
     fill: OmitDefault(Fill) = None
     uuid: UUID = field(default_factory=UUID)
 
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        _c, r, sweep, large = kicad_arc_svg_flags(self.start, self.mid, self.end)
+        yield _shape_svg(self, colorscheme, d=f'M {self.start.x:.3f} {self.start.y:.3f} '
+                         f'A {r:.3f} {r:.3f} 0 {int(large)} {int(sweep)} {self.end.x:.3f} {self.end.y:.3f}')
+
 
 @sexp_type('bezier')
 class Bezier:
@@ -195,6 +222,12 @@ class Bezier:
     fill: OmitDefault(Fill) = None
     uuid: UUID = field(default_factory=UUID)
 
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        if len(self.points) != 4:
+            return
+        p0, *rest = self.points
+        yield _shape_svg(self, colorscheme, d=f'M {p0.x:.3f} {p0.y:.3f} C ' + ' '.join(f'{p.x:.3f} {p.y:.3f}' for p in rest))
+
 
 def label_shape_path_d(shape, w, h):
     """ Outline of a global or hierarchical label of the given shape, height `h` and body width `w`, starting at the
@@ -632,6 +665,13 @@ class RuleArea:
     dnp: Named(YesNoAtom()) = None
     polyline: Polyline = None
 
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        if self.polyline is None or len(self.polyline.points) < 3:
+            return
+        p0, *rest = self.polyline.points
+        d = f'M {p0.x:.3f} {p0.y:.3f} ' + ' '.join(f'L {p.x:.3f} {p.y:.3f}' for p in rest) + ' Z'
+        yield _shape_svg(self.polyline, colorscheme, d=d)
+
 
