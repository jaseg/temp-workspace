  (text "J701 pin -> STM32G474:\n 3 ADC_IN        PA0 ADC12_IN1\n 5 VREFP         VREF+ (VREFBUF 2.9 V)\n 7 DAC_TRIG      PA4 DAC1_OUT1\n 8 DAC_OFS       PA5 DAC1_OUT2\n 9 DAC_TAPTH     PA6 DAC2_OUT1\n10 DAC_BIAS_A    PA2 OPAMP1 (DAC3_CH1)\n11 DAC_BIAS_K    PB1 OPAMP3 (DAC3_CH2)\n13 ADC_TRIG      EXTI11 pin (ADC12 ext. trigger)\n14 MCU_CLK       PF0 OSC_IN (HSE bypass)\n16 TRIG_SEL      GPIO\n17 RELAY_CTL     GPIO\n18 FPGA_DONE     GPIO in\n19 FPGA_RECONFIG GPIO open-drain\n20 I2C_SCL       I2C SCL\n21 I2C_SDA       I2C SDA\n22 SPI_SCK       SPI SCK\n23 SPI_MOSI      SPI MOSI\n24 SPI_MISO      SPI MISO\n25 SPI_CS        SPI NSS / GPIO\nGND: 1, 2, 4, 6, 12, 15, 26" (at 12.7 127 0) (effects (font (size 1 1)) (justify left top)) (uuid f6e92114-842a-5a67-a97e-bb38d6059265))
