diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 1ef9440..164170d 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -112,3 +112,15 @@ def test_symbol_body_style():
     assert '(body_style 2)' in serialized and '(in_pos_files yes)' in serialized
     sym, = Schematic.parse(serialized).symbols
     assert (sym.unit, sym.body_style, sym.in_pos_files) == (2, 2, True)
+
+
+def test_label_properties():
+    sch = Schematic.parse('''(kicad_sch (version 20260101) (generator "eeschema")
+        (global_label "SDA" (shape bidirectional) (at 10 10 0) (effects (font (size 1.27 1.27)))
+            (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes)
+                (effects (font (size 1.27 1.27))))))''')
+    label, = sch.global_labels
+    prop, = label.properties
+    assert (prop.key, prop.text, prop.show_name, prop.hide) == ('Intersheetrefs', '${INTERSHEET_REFS}', False, True)
+    label, = Schematic.parse(sch.serialize()).global_labels
+    assert label.properties[0].hide
