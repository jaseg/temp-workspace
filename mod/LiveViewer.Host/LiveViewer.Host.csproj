<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development host: runs LiveViewer.Server outside the game and feeds it a BSOR replay in real time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LiveViewer.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveViewer.Server\LiveViewer.Server.csproj" />
  </ItemGroup>

</Project>
