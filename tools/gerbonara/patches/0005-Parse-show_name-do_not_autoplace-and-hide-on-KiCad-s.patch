From 749b0ae26f9e927e6dc80808af90f5612f4fc8c2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:09:55 +0000
Subject: [PATCH 05/41] Parse show_name, do_not_autoplace and hide on KiCad
 symbol properties

KiCad 8 and later write (hide yes) on the property itself instead of in
its effects, KiCad 9 adds (show_name yes/no) and (do_not_autoplace
yes/no). Symbol library properties rejected all three, schematic
properties read (hide no) and (show_name no) as true. Library properties
keep None for absent flags so that files round trip unchanged, and their
SVG export now skips properties hidden this way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py |  4 +++-
 src/gerbonara/cad/kicad/symbols.py   |  8 ++++++--
 tests/test_kicad_schematic.py        | 16 ++++++++++++++++
 tests/test_kicad_symbols.py          | 15 +++++++++++++++
 4 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index aa0ce49..0abb4ba 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -311,7 +311,9 @@ class DrawnProperty(TextMixin):
     value: str = None
     id: Named(int) = None
     at: AtPos = field(default_factory=AtPos)
-    hide: Flag() = False
+    show_name: Named(LegacyCompatibleFlag()) = None
+    do_not_autoplace: Named(LegacyCompatibleFlag()) = None
+    hide: OmitDefault(Named(LegacyCompatibleFlag())) = False
     effects: TextEffect = field(default_factory=TextEffect)
     _: SEXP_END = None
     parent: object = None
diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index 6615b41..a2545ed 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -409,7 +409,10 @@ class Property(TextMixin):
     value: str = None
     id: Named(int) = None
     at: AtPos = field(default_factory=AtPos)
-    show_name: Flag() = False
+    # These three are None when absent, so files without them round trip unchanged.
+    show_name: Named(LegacyCompatibleFlag()) = None
+    do_not_autoplace: Named(LegacyCompatibleFlag()) = None
+    hide: Named(LegacyCompatibleFlag()) = None
     effects: TextEffect = field(default_factory=TextEffect)
 
     # Alias value for text mixin
@@ -422,7 +425,8 @@ class Property(TextMixin):
         self.value = value
 
     def to_svg(self, colorscheme=Colorscheme.KiCad):
-        yield from TextMixin.to_svg(self, colorscheme.text)
+        if not self.hide:
+            yield from TextMixin.to_svg(self, colorscheme.text)
 
 
 @sexp_type('pin_numbers')
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 80947c4..cc634db 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -84,3 +84,19 @@ def test_legacy_symbol_instances():
     assert [(i.path, i.reference, i.value) for i in sch.symbol_instances] == [('/1234', 'R1', '10k')]
     sch = Schematic.parse(sch.serialize())
     assert [(i.path, i.reference, i.value) for i in sch.symbol_instances] == [('/1234', 'R1', '10k')]
+
+
+
+def test_symbol_property_flags():
+    sch = Schematic.parse('''(kicad_sch (version 20260101) (generator "eeschema")
+        (symbol (lib_id "Device:R") (at 10 10 0) (unit 1)
+            (property "Reference" "R1" (at 0 0 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27))))
+            (property "Footprint" "" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
+            (property "Datasheet" "" (at 0 0 0) (hide no) (effects (font (size 1.27 1.27))))
+            (property "Legacy" "" (at 0 0 0) hide (effects (font (size 1.27 1.27))))))''')
+    sym, = sch.symbols
+    assert [(p.show_name, p.do_not_autoplace, p.hide) for p in sym.properties] == [
+            (False, False, False), (None, None, True), (None, None, False), (None, None, True)]
+    sym, = Schematic.parse(sch.serialize()).symbols
+    assert [(p.show_name, p.do_not_autoplace, p.hide) for p in sym.properties] == [
+            (False, False, False), (None, None, True), (None, None, False), (None, None, True)]
diff --git a/tests/test_kicad_symbols.py b/tests/test_kicad_symbols.py
index 7a489de..7778d56 100644
--- a/tests/test_kicad_symbols.py
+++ b/tests/test_kicad_symbols.py
@@ -121,3 +121,18 @@ def test_power_symbol_scope(spec, power, local):
     serialized = build_sexp(sym.sexp())
     assert spec in serialized
     assert build_sexp(Symbol.parse(serialized).sexp()) == serialized
+
+
+def test_property_flags():
+    sym = Symbol.parse('''(symbol "Device:R" (in_bom yes) (on_board yes)
+        (property "Reference" "R" (at 0 0 0) (show_name no) (do_not_autoplace yes) (effects (font (size 1.27 1.27))))
+        (property "Value" "R" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
+        (property "Footprint" "" (at 0 0 0) (do_not_autoplace) (effects (font (size 1.27 1.27)))))''')
+    ref, val, fp = sym.properties['Reference'], sym.properties['Value'], sym.properties['Footprint']
+    assert (ref.show_name, ref.do_not_autoplace, ref.hide) == (False, True, None)
+    assert (val.show_name, val.do_not_autoplace, val.hide) == (None, None, True)
+    assert fp.do_not_autoplace
+    assert list(val.to_svg()) == []
+    serialized = build_sexp(sym.sexp())
+    assert '(show_name no)' in serialized and '(hide yes)' in serialized
+    assert build_sexp(Symbol.parse(serialized).sexp()) == serialized
