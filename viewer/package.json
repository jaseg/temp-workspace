{
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack && node scripts/package.js",
    "start": "cross-env NODE_ENV=development webpack serve",
    "lint": "semistandard | snazzy",
    "lint:fix": "semistandard --fix",
