From e788c836311fc981b68a16ba81bb81c202d762f5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:11:38 +0000
Subject: [PATCH 14/52] Parse private properties of placed KiCad schematic
 symbols

Private library properties, such as the KLC_* notes of some library
symbols, end up in placed symbols as (property private ...).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 27151b9..b275406 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -220,6 +220,7 @@ def label_shape_path_d(shape, w, h):
 
 @sexp_type('property')
 class DrawnProperty(TextMixin):
+    private: Flag() = False
     key: str = None
     value: str = None
     id: Named(int) = None
@@ -536,8 +537,8 @@ class Subsheet:
     # AFAICT this is completely redundant, just like the one in SymbolInstance
     instances: Named(Array(SubsheetCrosslinkProject)) = field(default_factory=list)
     _ : SEXP_END = None
-    sheet_name: object = field(default_factory=lambda: DrawnProperty('Sheetname', ''))
-    file_name: object = field(default_factory=lambda: DrawnProperty('Sheetfile', ''))
+    sheet_name: object = field(default_factory=lambda: DrawnProperty(key='Sheetname', value=''))
+    file_name: object = field(default_factory=lambda: DrawnProperty(key='Sheetfile', value=''))
     extra_properties: list = field(default_factory=list)
     schematic: object = field(repr=False, default=None)
 
