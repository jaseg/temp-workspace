From eec003f8986d327b0767846311ccbef96f763d43 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:08:51 +0000
Subject: [PATCH 21/41] Fix point lists of KiCad symbol polylines and schematic
 lines

Point lists are parsed into plain lists, but symbol polylines, their
rectangle conversion and the SVG export of wires, buses and schematic
polylines still accessed them through a PointList object, so all of them
failed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py |  5 +++--
 src/gerbonara/cad/kicad/symbols.py   |  8 ++++----
 tests/test_kicad_schematic.py        |  8 ++++++++
 tests/test_kicad_symbols.py          | 17 +++++++++++++++++
 4 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index f50e90b..a5c6d4b 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -116,10 +116,11 @@ class BusEntry:
 
 def _polyline_svg(self, default_color):
     da = Dasher(self)
-    if len(self.points.xy) < 2:
+    if len(self.points) < 2:
         warnings.warn(f'Schematic {type(self)} with less than two points')
+        return Tag('path', d='')
 
-    p0, *rest = self.points.xy
+    p0, *rest = self.points
     da.move(p0.x, p0.y)
     for pn in rest:
         da.line(pn.x, pn.y)
diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index eeb2a09..c1faed3 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -317,17 +317,17 @@ class Bezier:
 
 @sexp_type('polyline')
 class Polyline:
-    pts: PointList = field(default_factory=PointList)
+    pts: PointList = field(default_factory=list)
     stroke: Stroke = field(default_factory=Stroke)
     fill: Fill = field(default_factory=Fill)
 
     @property
     def points(self):
-        return self.pts.xy
+        return self.pts
 
     @points.setter
     def points(self, value):
-        self.pts.xy = value
+        self.pts = value
 
     @property
     def closed(self):
@@ -417,7 +417,7 @@ class Rectangle:
     def to_polyline(self):
         x1, y1 = self.start.x, self.start.y
         x2, y2 = self.end.x, self.end.y
-        return Polyline(PointList([XYCoord(x1, y1), XYCoord(x2, y1), XYCoord(x2, y2), XYCoord(x1, y2), XYCoord(x1, y1)]),
+        return Polyline([XYCoord(x1, y1), XYCoord(x2, y1), XYCoord(x2, y2), XYCoord(x1, y2), XYCoord(x1, y1)],
                         self.stroke, self.fill)
 
     def to_svg(self, colorscheme=Colorscheme.KiCad):
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 4659059..d362ce0 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -244,3 +244,11 @@ def test_color_truthiness():
     assert bool(Color(0, 0, 0, 0)) is False
     assert bool(Color(255, 0, 0, 0)) is True
     assert bool(Color(0, 0, 0, 1)) is True
+
+
+def test_wire_svg():
+    sch = Schematic.parse('''(kicad_sch (version 20250114) (generator "eeschema")
+        (wire (pts (xy 0 0) (xy 10 0)) (stroke (width 0) (type default)) (uuid "w")))''')
+    wire, = sch.wires
+    path, = wire.to_svg()
+    assert path.attrs['d'] == 'M 0.000 0.000 L 10.000 0.000'
diff --git a/tests/test_kicad_symbols.py b/tests/test_kicad_symbols.py
index 378176c..7a7af37 100644
--- a/tests/test_kicad_symbols.py
+++ b/tests/test_kicad_symbols.py
@@ -170,3 +170,20 @@ def test_symbol_bezier():
     path, = curve.to_svg()
     assert path.attrs['d'] == 'M 0.000 0.000 C 1.000 2.000 3.000 2.000 4.000 0.000'
     assert '(bezier' in build_sexp(lib.sexp())
+
+
+def test_polyline_and_rectangle_svg():
+    lib = Library.parse('''(kicad_symbol_lib (version 20241209) (generator "kicad_symbol_editor")
+        (symbol "Box" (in_bom yes) (on_board yes)
+            (symbol "Box_1_1"
+                (polyline (pts (xy 0 0) (xy 1 2) (xy 3 2)) (stroke (width 0.254) (type solid)) (fill (type none)))
+                (rectangle (start 0 0) (end 2 1) (stroke (width 0.254) (type solid)) (fill (type background))))))''')
+    unit, = lib.symbols[0].units
+    line, = unit.polylines
+    assert [(p.x, p.y) for p in line.points] == [(0, 0), (1, 2), (3, 2)]
+    assert line.bounding_box() == ((0, 0), (3, 2))
+    path, = line.to_svg()
+    assert path.attrs['d'] == 'M 0.000 0.000 L 1.000 2.000 L 3.000 2.000'
+    rect, = unit.rectangles
+    path, = rect.to_svg()
+    assert path.attrs['d'].count('L') == 4
-- 
