<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDK-style port of the original project; builds against the Beat Saber 1.44.1 assemblies in mod/refs (see mod/README.md). Set BeatSaberRefs to use another location. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BeatSaverVoting</AssemblyName>
    <RootNamespace>BeatSaverVoting</RootNamespace>
    <LangVersion>9</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <BeatSaberRefs Condition="'$(BeatSaberRefs)' == ''">$(MSBuildThisFileDirectory)..\..\..\mod\refs</BeatSaberRefs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <GameReference Include="BeatSaber.Multiplayer.Core;BeatSaber.ViewSystem;Core;GameplayCore;HMLib;HMUI;IPA.Loader;Main;netstandard;OculusStudios.Platform.Core;PlatformUserModel;Zenject;Zenject-usage;Unity.TextMeshPro;UnityEngine;UnityEngine.CoreModule;UnityEngine.JSONSerializeModule;UnityEngine.UI;UnityEngine.AnimationModule;UnityEngine.AssetBundleModule;UnityEngine.UIModule;UnityEngine.VRModule;UnityEngine.UnityWebRequestModule;UnityEngine.ImageConversionModule" Dir="Managed" />
    <GameReference Include="BSML;BS_Utils;SongCore" Dir="Plugins" />
    <GameReference Include="0Harmony;Newtonsoft.Json" Dir="Libs" />
    <Reference Include="@(GameReference)">
      <HintPath>$(BeatSaberRefs)\%(Dir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DataModels" Publicize="true">
      <HintPath>$(BeatSaberRefs)\Managed\DataModels.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BGLib.AppFlow" Publicize="true">
      <HintPath>$(BeatSaberRefs)\Managed\BGLib.AppFlow.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="Icons\*.png" />
    <EmbeddedResource Include="UI\votingUI.bsml" />
  </ItemGroup>
</Project>
