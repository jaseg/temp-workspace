From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:18:06 +0000
Subject: [PATCH 39/41] Add SymbolInstance.transform_point() and
 transform_vector()

They map library symbol coordinates (y up) to sheet coordinates (y down)
following the placed symbol's rotation and mirroring, e.g. to find where
a pin ends up on the sheet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 19 +++++++++++++++++++
 tests/test_kicad_schematic.py        | 11 +++++++++++
 2 files changed, 30 insertions(+)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index a194309..ddf90ed 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -505,6 +505,25 @@ class SymbolInstance:
     def rotation(self):
         return self.at.rotation
 
+    def transform_vector(self, dx, dy):
+        """ Turn a vector in library symbol coordinates (y pointing up) into sheet coordinates (y pointing down),
+        following the symbol's rotation and mirroring. KiCad rotates first, then mirrors. """
+        a = math.radians(self.at.rotation or 0)
+        c, s = math.cos(a), math.sin(a)
+        c, s = (round(c) if abs(c - round(c)) < 1e-9 else c), (round(s) if abs(s - round(s)) < 1e-9 else s)
+        x, y = dx, -dy
+        x, y = x*c + y*s, -x*s + y*c
+        if self.mirror.x:
+            y = -y
+        elif self.mirror.y:
+            x = -x
+        return x, y
+
+    def transform_point(self, x, y):
+        """ Position of a point given in library symbol coordinates on the sheet. """
+        dx, dy = self.transform_vector(x, y)
+        return self.at.x + dx, self.at.y + dy
+
     @property
     def unit_count(self):
         """ Number of units of this symbol's library symbol, or 1 if it can't be found. """
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 9dbff01..410bf7e 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -404,3 +404,14 @@ def test_reference_unit_letters():
     r1, u1 = sch.symbols
     assert (r1.unit_count, r1['Reference'].text) == (1, 'R1')
     assert (u1.unit_count, u1['Reference'].text) == (2, 'U1B')
+
+
+@pytest.mark.parametrize('rotation, mirror, expected', [
+        (0, '', (12, 17)), (90, '', (7, 18)), (180, '', (8, 23)), (270, '', (13, 22)),
+        (0, '(mirror x)', (12, 23)), (0, '(mirror y)', (8, 17)), (90, '(mirror x)', (7, 22))])
+def test_symbol_transform(rotation, mirror, expected):
+    sch = Schematic.parse(f'''(kicad_sch (version 20250114) (generator "eeschema")
+        (symbol (lib_id "Device:R") (at 10 20 {rotation}) {mirror} (unit 1)))''')
+    sym, = sch.symbols
+    # library point (2, 3): right and up from the symbol's origin. KiCad rotates counter-clockwise on screen.
+    assert sym.transform_point(2, 3) == pytest.approx(expected)
