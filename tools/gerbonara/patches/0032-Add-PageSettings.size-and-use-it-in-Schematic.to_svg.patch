diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 016ade3..eb7d8a8 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -325,3 +325,12 @@ def test_paper_sizes():
     from gerbonara.cad.kicad.schematic import KICAD_PAPER_SIZES
     assert KICAD_PAPER_SIZES['B'] == pytest.approx((431.8, 279.4))
     assert KICAD_PAPER_SIZES['USLedger'] == KICAD_PAPER_SIZES['B']
+
+
+@pytest.mark.parametrize('paper, size', [('"A4"', (297, 210)), ('"A3" portrait', (297, 420)),
+                                         ('"User" 300 200', (300, 200)), ('"USLetter"', (279.4, 215.9))])
+def test_page_size(paper, size):
+    sch = Schematic.parse(f'(kicad_sch (version 20250114) (generator "eeschema") (paper {paper}))')
+    assert sch.page_settings.size == pytest.approx(size)
+    w, h = map(float, re.search(r'viewBox="0 0 (\S+) (\S+)"', str(sch.to_svg())).groups())
+    assert (w, h) == pytest.approx(size)
