# KiCad nightly + KiCAD-MCP-Server in one image.
#
#   podman build -t kicad-mcp .                                   # latest nightly
#   podman build -t kicad-mcp --build-arg NIGHTLY=$(date +%F) .   # pull a newer one
#   podman build -t kicad-mcp --build-arg WITH_3D=1 .             # + 3D models (2.1 GB)
#   podman build -t kicad-mcp \
#       --build-arg KICAD_BUILD=kicad-nightly-10.99.0.6365.g0e9822b635-x86_64 .  # pin one
#
# KiCad comes from KiCad's official nightly AppImage (rebuilt daily, see
# https://downloads.kicad.org/kicad/linux/explore/nightlies), checked against
# its minisign signature and extracted, so no FUSE is needed at run time. The
# AppImage brings its own libraries (GTK, Wayland, Mesa, ...), symbols and
# footprints.
#
# Nightlies have no SWIG `pcbnew` Python module, which the MCP server cannot
# even start without. A stand-in module (below) lets it start; board tools then
# work through KiCad's IPC API (KiCad running with the API enabled and the board
# open in the PCB editor), schematic tools on the files, exports via kicad-cli.
# Anything that needs SWIG fails with an error saying so.
#
# The container serves MCP, one server per connection, on /run/mcp/kicad.sock
# and, when certificates are mounted at /run/tls, over mutual TLS on TCP port
# $MCP_TLS_PORT (for clients that can't share a Unix socket, such as a krun
# microVM).
FROM docker.io/library/ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN userdel -r ubuntu 2>/dev/null || true \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl git procps socat minisign \
        python3 python3-venv nodejs npm \
        adwaita-icon-theme fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

# MCP server, before KiCad, so a new nightly doesn't rebuild this layer.
ARG MCP_REF=stable
RUN git clone --depth 1 -b "$MCP_REF" https://github.com/mixelpixx/KiCAD-MCP-Server /opt/kicad-mcp \
 && cd /opt/kicad-mcp \
 && python3 -m venv .venv \
 && .venv/bin/pip install --no-cache-dir -r requirements.txt \
 && npm ci \
 && npm prune --omit=dev \
 && npm cache clean --force

# Stand-in for the SWIG pcbnew module. The server imports pcbnew in a dozen
# modules at start-up and its Python worker exits without it, closing the MCP
# connection right after the handshake. With this the imports succeed; any
# actual use raises an error that the tool call reports.
COPY <<'EOF' /opt/pcbnew-stub/pcbnew.py
"""Stand-in for KiCad's SWIG `pcbnew` module, which KiCad nightly no longer ships.

KiCAD-MCP-Server imports pcbnew throughout and its Python worker cannot start
without it. With this module the imports succeed; anything that really calls
into SWIG fails with an explanatory error instead. Tools that work through the
KiCad IPC API, on schematic files or through kicad-cli are unaffected.
"""

MESSAGE = (
    "pcbnew.{} is not available: KiCad nightly has no SWIG Python bindings. "
    "Tools that work through the KiCad IPC API (with the board open in the PCB "
    "editor), on schematic files or through kicad-cli still work."
)


class _Missing:
    """Any pcbnew name: attribute access gives more of these, using one raises."""

    def __init__(self, name):
        self._name = name

    def __getattr__(self, attr):
        if attr.startswith("__"):
            raise AttributeError(attr)
        return _Missing(f"{self._name}.{attr}")

    def __call__(self, *args, **kwargs):
        raise RuntimeError(MESSAGE.format(self._name))

    def __repr__(self):
        return f"<unavailable pcbnew.{self._name}>"


def __getattr__(name):
    if name.startswith("__"):
        raise AttributeError(name)
    return _Missing(name)
EOF
# The server hands PYTHONPATH on to its Python worker.
ENV PYTHONPATH=/opt/pcbnew-stub

# KICAD_BUILD: "latest", or a build's name as on the downloads page, without
# ".AppImage" and without "-lite".
ARG KICAD_BUILD=latest
ARG WITH_3D=0
ARG NIGHTLY=unset
# The key KiCad signs its AppImages with, as published in
# https://kicad-downloads.s3.cern.ch/appimage/latest.json (November 2026).
ARG KICAD_PUBKEY=RWSyix0AVvjWQGZChX64ywBpE5XqV1Eg+ZXYHR3Y27md9EoZ0AtVr9i9
RUN <<'EOF'
set -eu
echo "nightly: $NIGHTLY"
url=https://kicad-downloads.s3.cern.ch/appimage
name=$KICAD_BUILD
if [ "$name" = latest ]; then
    name=$(curl -fsSL "$url/latest.json" | python3 -c \
        'import json, sys; print(json.load(sys.stdin)["variants"]["nightly"]["filename"])')
    name=${name%.AppImage}
fi
[ "$WITH_3D" = 1 ] || name=$name-lite
echo "KiCad: $name"
cd /tmp
curl -fL --no-progress-meter "$url/nightly/$name.AppImage.tar" | tar x
curl -fsSL -o "$name.AppImage.minisig" "$url/nightly/$name.AppImage.minisig"
minisign -V -P "$KICAD_PUBKEY" -m "$name.AppImage" -x "$name.AppImage.minisig"
chmod +x "$name.AppImage"
"./$name.AppImage" --appimage-extract >/dev/null
# Newer runtimes extract to AppDir/ and leave squashfs-root as a link to it.
mv "$(realpath squashfs-root)" /opt/kicad
rm -f squashfs-root
echo "$name" > /opt/kicad/BUILD
rm -f "$name.AppImage" "$name.AppImage.minisig"
# The MCP server runs `kicad`, `pcbnew`, `kicad-cli`, ... and reads
# /usr/share/kicad.
for b in kicad pcbnew eeschema kicad-cli; do
    printf '#!/bin/sh\nexec /opt/kicad/AppRun %s "$@"\n' "$b" > "/usr/local/bin/$b"
    chmod 0755 "/usr/local/bin/$b"
done
ln -s /opt/kicad/share/kicad /usr/share/kicad
EOF

# GTK wants a private, writable XDG_RUNTIME_DIR.
COPY --chmod=0755 <<'EOF' /usr/local/bin/entry
#!/bin/sh
mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
exec "$@"
EOF

# The MCP server on stdio. Starts KiCad if it isn't running, without waiting
# for it: the server answers the MCP handshake at once and connects to KiCad's
# API whenever a tool needs it.
COPY --chmod=0755 <<'EOF' /usr/local/bin/kicad-mcp
#!/bin/sh
kicad_running() {
    for exe in /proc/[0-9]*/exe; do
        case $(readlink "$exe" 2>/dev/null) in
            */kicad-cli) ;;
            /opt/kicad/*) return 0 ;;
        esac
    done
    return 1
}
kicad_running || setsid -f kicad >/dev/null 2>&1
exec node /opt/kicad-mcp/dist/index.js
EOF

# MCP listeners. TLS: the server presents server.pem and only accepts a client
# presenting exactly the certificate in client.crt.
COPY --chmod=0755 <<'EOF' /usr/local/bin/serve
#!/bin/sh
if [ -r /run/tls/server.pem ] && [ -r /run/tls/client.crt ]; then
    socat "OPENSSL-LISTEN:${MCP_TLS_PORT:-8765},reuseaddr,fork,cert=/run/tls/server.pem,cafile=/run/tls/client.crt,verify=1,openssl-min-proto-version=TLS1.3" \
        EXEC:/usr/local/bin/kicad-mcp &
fi
exec socat UNIX-LISTEN:/run/mcp/kicad.sock,fork,unlink-early,mode=0600 EXEC:/usr/local/bin/kicad-mcp
EOF

ENTRYPOINT ["/usr/local/bin/entry"]
CMD ["/usr/local/bin/serve"]
