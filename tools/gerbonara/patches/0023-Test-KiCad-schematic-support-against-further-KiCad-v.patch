 import os
+import re
 from pathlib import Path
 import tqdm
 import multiprocessing.pool
@@ -84,11 +85,40 @@ def _update_repo_cache(lib_dir, repo_url, tag):
             return False
 
 
+def _update_sparse_repo_cache(lib_dir, repo_url, rev, patterns):
+    """ Like _update_repo_cache, but only check out the files matching `patterns`, without history and without
+    fetching any other files. `rev` can be a tag or a commit hash. """
+    git = lambda *args, check=True, **kwargs: subprocess.run(
+            ['git', '-c', 'advice.detachedHead=false', '-C', str(lib_dir), *args], check=check, **kwargs)
+    if not lib_dir.is_dir():
+        print(f'Checking out KiCad source repo at {rev}')
+        lib_dir.mkdir(parents=True)
+        git('init', '-q')
+        git('remote', 'add', 'origin', repo_url)
+    git('sparse-checkout', 'set', '--no-cone', *patterns)
+
+    head = git('rev-parse', '-q', '--verify', 'HEAD', capture_output=True, text=True, check=False).stdout.strip()
+    wanted = git('rev-parse', '-q', '--verify', f'{rev}^{{commit}}', capture_output=True, text=True,
+                 check=False).stdout.strip()
+    if head and head == wanted:
+        return False
+
+    git('fetch', '-q', '--depth', '1', '--filter=blob:none', 'origin', rev)
+    if not re.fullmatch('[0-9a-f]{40}', rev):
+        git('tag', '-f', rev, 'FETCH_HEAD')
+    git('checkout', '-q', 'FETCH_HEAD')
+    return True
+
+
+KICAD_SOURCE_SCHEMATIC_PATTERNS = ['/demos/**/*.kicad_sch', '/qa/data/**/*.kicad_sch']
+
+
