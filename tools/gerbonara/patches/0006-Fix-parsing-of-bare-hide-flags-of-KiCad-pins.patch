From fc5cfdd41dfb26b68722fbea5ba68d0636cf318f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 17:10:25 +0000
Subject: [PATCH 06/52] Fix parsing of bare hide flags of KiCad pins

KiCad 7 writes (pin_names hide), (pin_numbers hide) and (pin ... hide) as
bare flags, which were parsed as not hidden. KiCad 8 and later write
(hide yes).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index c742e08..aa54e93 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -52,7 +52,7 @@ class Pin:
     style: PIN_STYLE = Atom.line
     at: AtPos = field(default_factory=AtPos)
     length: Named(float) = 2.54
-    hide: OmitDefault(Named(YesNoAtom())) = False
+    hide: OmitDefault(Named(LegacyCompatibleFlag())) = False
     name: Rename(StyledText) = field(default_factory=StyledText)
     number: Rename(StyledText) = field(default_factory=StyledText)
     alternates: List(AltFunction) = field(default_factory=list)
@@ -427,13 +427,13 @@ class Property(TextMixin):
 
 @sexp_type('pin_numbers')
 class PinNumberSpec:
-    hide: Named(YesNoAtom()) = False
+    hide: Named(LegacyCompatibleFlag()) = False
 
 
 @sexp_type('pin_names')
 class PinNameSpec:
     offset: OmitDefault(Named(float)) = 0.508
-    hide: OmitDefault(Named(YesNoAtom())) = False
+    hide: OmitDefault(Named(LegacyCompatibleFlag())) = False
 
 @sexp_type('text_box')
 class TextBox:
-- 
2.43.0

