{#- A cable along the path `d` in `color` (outline, colour, a white highlight), ending in the drawn `plug`. #}
<path d="{{ d }}" fill="none" stroke="{{ LINE }}" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
<path d="{{ d }}" fill="none" stroke="{{ color }}" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>
<path d="{{ d }}" fill="none" stroke="#fff" stroke-width=".22" stroke-linecap="round" opacity=".75" transform="translate(-.18 -.18)"/>
{{ plug }}
