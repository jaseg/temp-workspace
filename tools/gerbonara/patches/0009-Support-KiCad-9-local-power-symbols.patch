From ceb49666da10474e2026e162743f0b078e73b3bf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:09:11 +0000
Subject: [PATCH 09/52] Support KiCad 9 local power symbols

KiCad 9 writes (power global) or (power local) instead of a bare (power).
Parse it into a PowerSpec that keeps the scope, so both round trip.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index a0244ca..7b24e3b 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -499,11 +499,23 @@ class Unit:
         return stacks
 
 
+@sexp_type('power')
+class PowerSpec:
+    """ Marks a symbol as a power symbol. KiCad 9 added local power symbols, whose net is local to their sheet. Their
+    scope is ``local``, and the scope of global power symbols is ``global``. Files from older KiCad versions only have a
+    bare ``(power)``, for which scope is None. """
+    scope: AtomChoice(Atom('global'), Atom('local')) = None
+
+    @property
+    def is_local(self):
+        return self.scope == 'local'
+
+
 @sexp_type('symbol')
 class Symbol:
     raw_name: str = None
     extends: Named(str) = None
-    power: Wrap(Flag()) = False
+    power: PowerSpec = None
     pin_numbers: OmitDefault(PinNumberSpec) = field(default_factory=PinNumberSpec)
     pin_names: OmitDefault(PinNameSpec) = field(default_factory=PinNameSpec)
     exclude_from_sim: OmitDefault(Named(YesNoAtom())) = False
