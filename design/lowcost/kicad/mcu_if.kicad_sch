  (text "ADC_REF_MID = VREF+ x 10k/40k = 0.725 V\n(level-shift reference on the sampler sheet)" (at 184.15 25.4 0) (effects (font (size 1 1)) (justify left top)) (uuid 7a305f94-7861-5874-b68f-513bf861371a))
  (label "VREFP" (at 125.73 104.14 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid 016a0b1f-bc19-5724-af76-9e305a17f220))
  (hierarchical_label "VNEG_REF" (shape output) (at 171.45 101.6 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 7f92e556-197d-53b3-9240-b2f1cb7bd15a))
  (text "VNEG_REF = -VREF+ x R732/R731 = -1.973 V, ratiometric to the DACs\n(mid-scale of VOFS cancels independent of VREF+ and of -2V5).\nLoad: Rmid 34.0k on the input sheet only. C722 100n: 160 Hz.\nU701 TLV9001IDBVR on +/-2V5; C720/C721 at its pins 5/2.\nReset: VREFBUF off (VREF+ ~0 V) -> VNEG_REF = 0 V." (at 120.65 129.54 0) (effects (font (size 1 1)) (justify left top)) (uuid ff06c835-0b27-5840-aa31-fafc3e362388))
  (label "DAC_BIAS_A" (at 234.95 82.55 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 4df0fed2-f497-5bd5-9f8b-b4b6401ae8dd))
  (hierarchical_label "VBIAS_A" (shape output) (at 247.65 92.71 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 72295f68-8fbf-5a8b-957a-491ce85fa783))
  (text "VBIAS_A = 0.385 x Vdac - 0.615 x 2.5 V (Thevenin 2.89k,\nwith 10 nF on the sampler sheet: 5.5 kHz):\nDAC 0.2..2.7 V -> -1.46..-0.50 V, 0.27 mV/LSB.\nReset (PA6 high-Z, clamped ~-0.4 V): about -1.7 V = reverse bias.\nDAC load 12.2k to -2V5 (<= 0.43 mA)." (at 215.9 66.04 0) (effects (font (size 1 1)) (justify left top)) (uuid d765f12f-fc5f-57f2-9d43-187c316ce211))
  (label "DAC_BIAS_K" (at 227.33 149.86 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid 2137843c-4b3b-562c-8355-1b9e08410ecf))
  (hierarchical_label "VBIAS_K" (shape output) (at 251.46 149.86 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 7b2fe3eb-3175-58e6-8183-e1da5ae45231))
  (text "VBIAS_K = 0.520 x Vdac (DAC3_CH2 -> OPAMP3 -> PB1 -> R735 4.7k / R736 5.1k):\n+0.10..+1.40 V, 0.37 mV/LSB; nominal +1.3 V (sim/strobe_arms). Bridge reverse voltage\n<= 1.40 + 1.5 V (CLL clamp) = 2.9 V < 4 V (PARTS-4). Thevenin 2.45k: rectified strobe\ncurrent 4.3 uA x 3.45k = 15 mV (calibrated). DAC load 9.8k (<= 0.28 mA). Reset: 0 V." (at 215.9 171.45 0) (effects (font (size 1 1)) (justify left top)) (uuid 44db53d2-1044-5db8-92c9-102997db94dc))
  (label "DAC_TAPTH" (at 114.3 196.85 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ab8e911f-a3de-5009-bc9b-93e4e0b4a865))
