<Project Sdk="Microsoft.NET.Sdk">

  <!-- No Unity or game references: this assembly builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>LiveViewer.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vendor\EmbedIO\EmbedIO.csproj" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Beat Saber ships Newtonsoft.Json 13 (via BSIPA), so the plugin adds nothing. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiveViewer.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="www\**\*" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
