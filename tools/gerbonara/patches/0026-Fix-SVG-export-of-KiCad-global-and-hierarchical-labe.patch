From c78bfc20d1e7dfda50ebf1d499df065df642947d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:11:37 +0000
Subject: [PATCH 26/41] Fix SVG export of KiCad global and hierarchical labels

GlobalLabel.to_svg() called to_svg() on object() and HierarchicalLabel's
unpacked a generator, so both failed, and both would then have replaced
the text's own transform, losing its position. The global label's frame
also used the text's height as its width.

Place the outline at the connection point, turned the way the label
points, and the text after it, kept upright as KiCad shows it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 34 +++++++++++++++++++---------
 tests/test_kicad_schematic.py        | 17 ++++++++++++++
 2 files changed, 40 insertions(+), 11 deletions(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 084a750..7694dd1 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -324,25 +324,37 @@ class LocalLabel(TextLabel):
         yield from TextMixin.to_svg(self, colorscheme.labels)
 
 
+def _label_svg(label, colorscheme, text_offset, frame_d):
+    """ SVG export shared by global and hierarchical labels. `frame_d` is the label's outline, drawn from the
+    connection point towards +x, and the text starts `text_offset` from the connection point in the same direction.
+    Both are turned the way the label points; the text stays upright. """
+    x, y, rot = label.at.x, label.at.y, round(label.at.rotation or 0) % 360
+    dx, dy = {0: (1, 0), 90: (0, -1), 180: (-1, 0), 270: (0, 1)}.get(rot, (1, 0))
+    text = Newstroke.load().render_svg(label.text,
+                                       size=label.size,
+                                       h_align='left' if rot in (0, 90) else 'right',
+                                       v_align='middle',
+                                       rotation=-90 if rot in (90, 270) else 0,
+                                       scale=(1, 1),
+                                       stroke=colorscheme.labels,
+                                       transform=f'translate({x + dx*text_offset:.3f} {y + dy*text_offset:.3f})')
+    frame = Tag('path', fill='none', stroke_width=0.254, stroke=colorscheme.lines, d=frame_d,
+                transform=f'translate({x:.3f} {y:.3f}) rotate({-rot})')
+    return Tag('g', children=[frame, text])
+
+
 @sexp_type('global_label')
 class GlobalLabel(TextLabel):
     def to_svg(self, colorscheme=Colorscheme.KiCad):
-        text = super(TextMixin, self).to_svg(colorscheme.labels),
-        text.attrs['transform'] = f'translate({self.size*0.6:.3f} 0)'
-        (x1, y1), (x2, y2) = self.bounding_box()
-        frame = Tag('path', fill='none', stroke_width=0.254, stroke=colorscheme.lines,
-            d=label_shape_path_d(self.shape, self.size*0.2 + y2-y1, self.size*1.2 + 0.254))
-        yield Tag('g', children=[frame, text])
+        (_x1, _y1), (w, _y2) = Newstroke.load().bounding_box(self.text, size=self.size)
+        yield _label_svg(self, colorscheme, self.size*0.6,
+                         label_shape_path_d(self.shape, w + self.size*0.2, self.size*1.2 + 0.254))
 
 
 @sexp_type('hierarchical_label')
 class HierarchicalLabel(TextLabel):
     def to_svg(self, colorscheme=Colorscheme.KiCad):
-        text, = TextMixin.to_svg(self, colorscheme.labels),
-        text.attrs['transform'] = f'translate({self.size*1.2:.3f} 0)'
-        frame = Tag('path', fill='none', stroke_width=0.254, stroke=colorscheme.lines,
-            d=label_shape_path_d(self.shape, self.size, self.size))
-        yield Tag('g', children=[frame, text])
+        yield _label_svg(self, colorscheme, self.size*1.2, label_shape_path_d(self.shape, 0, self.size))
 
 
 @sexp_type('netclass_flag')
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 0968490..5c706ab 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -270,3 +270,20 @@ def test_label_shape_ends(shape, ends):
     # a pointed end has a vertex on the center line at that end, a square one two corners
     assert ((0.0, 0.0) in pts) == (ends[0] == '<')
     assert ((12.0, 0.0) in pts) == (ends[1] == '>')
+
+
+@pytest.mark.parametrize('rotation, side', [(0, 1), (90, -1), (180, -1), (270, 1)])
+def test_label_svg(rotation, side):
+    sch = Schematic.parse(f'''(kicad_sch (version 20250114) (generator "eeschema")
+        (global_label "SDA" (shape input) (at 10 20 {rotation}) (effects (font (size 1.27 1.27))) (uuid "g"))
+        (hierarchical_label "SCL" (shape output) (at 10 20 {rotation}) (effects (font (size 1.27 1.27))) (uuid "h")))''')
+    for label in sch.global_labels + sch.hierarchical_labels:
+        group, = label.to_svg()
+        frame, text = group.children
+        assert frame.attrs['transform'] == f'translate(10.000 20.000) rotate({-rotation})'
+        # the text starts on the side the label points to
+        tx, ty = map(float, re.match(r'translate\((\S+) (\S+)\)', text.attrs['transform']).groups())
+        if rotation in (0, 180):
+            assert (tx - 10) * side > 0 and ty == 20
+        else:
+            assert (ty - 20) * side > 0 and tx == 10
