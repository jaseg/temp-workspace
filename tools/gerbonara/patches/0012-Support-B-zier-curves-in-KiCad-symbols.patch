KiCad 9 can draw cubic Bézier curves in symbols. Parse them and export
them to SVG.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 24 ++++++++++++++++++++++++
 tests/test_kicad_symbols.py        | 14 ++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index 233df08..eeb2a09 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -293,6 +293,28 @@ class Arc:
                   **self.stroke.svg_attrs(colorscheme.lines))
 
 
+@sexp_type('bezier')
+class Bezier:
+    """ Cubic Bézier curve, given by its start point, two control points and end point. """
+    points: PointList = field(default_factory=list)
+    stroke: Stroke = field(default_factory=Stroke)
+    fill: Fill = field(default_factory=Fill)
+
+    def bounding_box(self, default=None):
+        # The control polygon contains the curve.
+        if not self.points:
+            return default
+        return (min(p.x for p in self.points), min(p.y for p in self.points)), \
+               (max(p.x for p in self.points), max(p.y for p in self.points))
+
+    def to_svg(self, colorscheme=Colorscheme.KiCad):
+        if len(self.points) != 4:
+            return
+        p0, *rest = self.points
+        d = f'M {p0.x:.3f} {p0.y:.3f} C ' + ' '.join(f'{p.x:.3f} {p.y:.3f}' for p in rest)
+        yield Tag('path', d=d, fill=self.fill.svg(colorscheme.lines, colorscheme.fill), **self.stroke.svg_attrs(colorscheme.lines))
+
+
 @sexp_type('polyline')
 class Polyline:
     pts: PointList = field(default_factory=PointList)
@@ -457,6 +479,7 @@ class Unit:
     circles: List(Circle) = field(default_factory=list)
     arcs: List(Arc) = field(default_factory=list)
     polylines: List(Polyline) = field(default_factory=list)
+    beziers: List(Bezier) = field(default_factory=list)
     rectangles: List(Rectangle) = field(default_factory=list)
     texts: List(Text) = field(default_factory=list)
     text_boxes: List(TextBox) = field(default_factory=list)
@@ -488,6 +511,7 @@ class Unit:
         yield from self.polylines
         yield from self.circles
         yield from self.arcs
+        yield from self.beziers
         yield from self.texts
 
     def __before_sexp__(self):
diff --git a/tests/test_kicad_symbols.py b/tests/test_kicad_symbols.py
index 60b78a6..378176c 100644
--- a/tests/test_kicad_symbols.py
+++ b/tests/test_kicad_symbols.py
@@ -156,3 +156,17 @@ def test_body_styles(spec):
     serialized = build_sexp(sym.sexp())
     assert spec in serialized
     assert build_sexp(Symbol.parse(serialized).sexp()) == serialized
+
+
+def test_symbol_bezier():
+    lib = Library.parse('''(kicad_symbol_lib (version 20241209) (generator "kicad_symbol_editor")
+        (symbol "Squiggle" (in_bom yes) (on_board yes)
+            (symbol "Squiggle_1_1"
+                (bezier (pts (xy 0 0) (xy 1 2) (xy 3 2) (xy 4 0)) (stroke (width 0.254) (type solid)) (fill (type none))))))''')
+    unit, = lib.symbols[0].units
+    curve, = unit.beziers
+    assert [(p.x, p.y) for p in curve.points] == [(0, 0), (1, 2), (3, 2), (4, 0)]
+    assert curve.bounding_box() == ((0, 0), (4, 2))
+    path, = curve.to_svg()
+    assert path.attrs['d'] == 'M 0.000 0.000 C 1.000 2.000 3.000 2.000 4.000 0.000'
+    assert '(bezier' in build_sexp(lib.sexp())
