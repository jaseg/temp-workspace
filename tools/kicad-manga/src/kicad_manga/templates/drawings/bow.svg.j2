{#- A ribbon bow in `color`, its knot at (x, y). #}
{% from 'drawings/wrap.svg.j2' import wrap %}
{% call wrap(0.3) %}
<g transform="translate({{ x|f }} {{ y|f }})">
  <path d="M0 0C-2.5 -2 -4 -.5 -3.5 1 -3 2.3 -1.2 1.4 0 0Z" fill="{{ color }}"/>
  <path d="M0 0C2.5 -2 4 -.5 3.5 1 3 2.3 1.2 1.4 0 0Z" fill="{{ color }}"/>
  <path d="M0 0L-1.4 3.4M0 0L1.4 3.4" fill="none" stroke-width=".6"/>
  <circle r=".8" fill="{{ color }}"/>
</g>
{% endcall %}
