From 9bd68cd81058a49edccb1b343ef1564b3e8b8cff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:18:44 +0000
Subject: [PATCH 41/41] Test SVG export of all KiCad demo and QA schematics

Every schematic of the test corpus has to export to well-formed SVG of
the right page size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 tests/test_kicad_schematic.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 1d1cd1d..33877be 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -426,3 +426,11 @@ def test_property_is_hidden():
     ref, value, fp = sch.symbols[0].properties
     assert [p.is_hidden for p in (ref, value, fp)] == [False, True, True]
     assert list(fp.to_svg()) == [] and list(value.to_svg()) == []
+
+
+def test_schematic_svg_export(kicad_sch_file):
+    import xml.etree.ElementTree as ET
+    sch = Schematic.open(kicad_sch_file)
+    root = ET.fromstring(str(sch.to_svg()))
+    w, h = sch.page_settings.size
+    assert [float(v) for v in root.get('viewBox').split()] == pytest.approx([0, 0, w, h])
