From d93d93e36465c5f50325ec558ccb65604eddaaa4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:09:34 +0000
Subject: [PATCH 24/41] Fix horizontal alignment of right-justified KiCad text

TextMixin.h_align returned 'left' for any horizontal justification, so
right-justified text was exported left-aligned.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/base_types.py | 2 +-
 tests/test_kicad_schematic.py         | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/gerbonara/cad/kicad/base_types.py b/src/gerbonara/cad/kicad/base_types.py
index 30079e5..665b93c 100644
--- a/src/gerbonara/cad/kicad/base_types.py
+++ b/src/gerbonara/cad/kicad/base_types.py
@@ -446,7 +446,7 @@ class TextMixin:
 
     @property
     def h_align(self):
-        return 'left' if self.effects.justify.h else 'center'
+        return self.effects.justify.h_str
 
     @property
     def mirrored(self):
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index d362ce0..eaf1493 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -252,3 +252,11 @@ def test_wire_svg():
     wire, = sch.wires
     path, = wire.to_svg()
     assert path.attrs['d'] == 'M 0.000 0.000 L 10.000 0.000'
+
+
+@pytest.mark.parametrize('justify, align', [('', 'center'), ('(justify left)', 'left'), ('(justify right)', 'right'),
+                                            ('(justify right bottom)', 'right')])
+def test_text_h_align(justify, align):
+    sch = Schematic.parse(f'''(kicad_sch (version 20250114) (generator "eeschema")
+        (text "hello" (at 10 10 0) (effects (font (size 1.27 1.27)) {justify}) (uuid "t")))''')
+    assert sch.texts[0].h_align == align
-- 
2.43.0

