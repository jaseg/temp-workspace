# KiCad nightly + KiCAD-MCP-Server in one image.
#
#   podman build -t kicad-mcp .                                   # latest nightly
#   podman build -t kicad-mcp --build-arg NIGHTLY=$(date +%F) .   # pull a newer one
#   podman build -t kicad-mcp --build-arg WITH_3D=1 .             # + 3D models (2.1 GB)
#   podman build -t kicad-mcp \
#       --build-arg KICAD_BUILD=kicad-nightly-10.99.0.6365.g0e9822b635-x86_64 .  # pin one
#
# KiCad comes from KiCad's official nightly AppImage (rebuilt daily, see
# https://downloads.kicad.org/kicad/linux/explore/nightlies), checked against
# its minisign signature and extracted, so no FUSE is needed at run time. The
# AppImage brings its own libraries (GTK, Wayland, Mesa, ...), symbols and
# footprints.
#
# Nightlies have no SWIG `pcbnew` Python module, so the MCP server runs IPC-only:
# KiCad must be running with the API enabled (kicad-mcp below starts it).
#
# The container serves MCP on /run/mcp/kicad.sock, one server per connection,
# so an MCP client in another container only needs that socket.
FROM docker.io/library/ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN userdel -r ubuntu 2>/dev/null || true \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl git procps socat minisign \
        python3 python3-venv nodejs npm \
        adwaita-icon-theme fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

# MCP server, before KiCad, so a new nightly doesn't rebuild this layer.
ARG MCP_REF=stable
RUN git clone --depth 1 -b "$MCP_REF" https://github.com/mixelpixx/KiCAD-MCP-Server /opt/kicad-mcp \
 && cd /opt/kicad-mcp \
 # The server refuses to start unless `import pcbnew` works. It already runs
 # IPC-only when pcbnew is missing and IPC is up, so drop that start-up check.
 && grep -q "import pcbnew; print('OK')" src/server.ts \
 && sed -i "s/import pcbnew; print('OK')/print('OK')/" src/server.ts \
 && python3 -m venv .venv \
 && .venv/bin/pip install --no-cache-dir -r requirements.txt \
 && npm ci \
 && npm prune --omit=dev \
 && npm cache clean --force

# KICAD_BUILD: "latest", or a build's name as on the downloads page, without
# ".AppImage" and without "-lite".
ARG KICAD_BUILD=latest
ARG WITH_3D=0
ARG NIGHTLY=unset
# The key KiCad signs its AppImages with, as published in
# https://kicad-downloads.s3.cern.ch/appimage/latest.json (November 2026).
ARG KICAD_PUBKEY=RWSyix0AVvjWQGZChX64ywBpE5XqV1Eg+ZXYHR3Y27md9EoZ0AtVr9i9
RUN <<'EOF'
set -eu
echo "nightly: $NIGHTLY"
url=https://kicad-downloads.s3.cern.ch/appimage
name=$KICAD_BUILD
if [ "$name" = latest ]; then
    name=$(curl -fsSL "$url/latest.json" | python3 -c \
        'import json, sys; print(json.load(sys.stdin)["variants"]["nightly"]["filename"])')
    name=${name%.AppImage}
fi
[ "$WITH_3D" = 1 ] || name=$name-lite
echo "KiCad: $name"
cd /tmp
curl -fL --no-progress-meter "$url/nightly/$name.AppImage.tar" | tar x
curl -fsSL -o "$name.AppImage.minisig" "$url/nightly/$name.AppImage.minisig"
minisign -V -P "$KICAD_PUBKEY" -m "$name.AppImage" -x "$name.AppImage.minisig"
chmod +x "$name.AppImage"
"./$name.AppImage" --appimage-extract >/dev/null
# Newer runtimes extract to AppDir/ and leave squashfs-root as a link to it.
mv "$(realpath squashfs-root)" /opt/kicad
rm -f squashfs-root
echo "$name" > /opt/kicad/BUILD
rm -f "$name.AppImage" "$name.AppImage.minisig"
# The MCP server runs `kicad`, `pcbnew`, `kicad-cli`, ... and reads
# /usr/share/kicad.
for b in kicad pcbnew eeschema kicad-cli; do
    printf '#!/bin/sh\nexec /opt/kicad/AppRun %s "$@"\n' "$b" > "/usr/local/bin/$b"
    chmod 0755 "/usr/local/bin/$b"
done
ln -s /opt/kicad/share/kicad /usr/share/kicad
EOF

# GTK wants a private, writable XDG_RUNTIME_DIR.
COPY --chmod=0755 <<'EOF' /usr/local/bin/entry
#!/bin/sh
mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
exec "$@"
EOF

# The MCP server on stdio. Without SWIG pcbnew it needs KiCad's IPC socket at
# start-up, so start KiCad if it isn't running and wait for the socket.
COPY --chmod=0755 <<'EOF' /usr/local/bin/kicad-mcp
#!/bin/sh
kicad_running() {
    for exe in /proc/[0-9]*/exe; do
        case $(readlink "$exe" 2>/dev/null) in
            */kicad-cli) ;;
            /opt/kicad/*) return 0 ;;
        esac
    done
    return 1
}
kicad_running || setsid -f kicad >/dev/null 2>&1
i=0
until ls /tmp/kicad/*.sock >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -gt 60 ]; then
        echo "kicad-mcp: no KiCad API socket after 60 s." \
             "In KiCad: Preferences > Plugins > Enable KiCad API, then restart KiCad." >&2
        exit 1
    fi
    sleep 1
done
exec node /opt/kicad-mcp/dist/index.js
EOF

ENTRYPOINT ["/usr/local/bin/entry"]
CMD ["socat", "UNIX-LISTEN:/run/mcp/kicad.sock,fork,unlink-early,mode=0600", "EXEC:/usr/local/bin/kicad-mcp"]
