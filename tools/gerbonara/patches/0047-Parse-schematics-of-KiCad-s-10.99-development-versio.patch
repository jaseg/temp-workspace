+    name: Named(str) = ''
+    type: Named(AtomChoice(Atom.datasheet, Atom.font, Atom.model, Atom.worksheet, Atom.other)) = Atom.other
+    data: VerbatimValues('data') = field(default_factory=list)
+    checksum: Named(str) = None
+
+
