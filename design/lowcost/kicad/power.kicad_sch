  (hierarchical_label "+5V1" (shape output) (at 198.12 44.45 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid c736d53b-37d3-546e-8cd5-244d74625ff1))
  (text "+5V1 = 5.115 V (5.054-5.177 V, <= 5.2 V VO max): GVA-84+ x2 bias tees\non the strobe sheet, own track from C610/C611 (not through FB602).\nEN, MODE = VIN: always on, forced PWM 1.4-2.1 MHz." (at 127 74.93 0) (effects (font (size 1 1)) (justify left top)) (uuid c74f0bc3-d8e5-5aa1-84e8-9379e4995cb5))
  (label "+5V1F" (at 212.09 48.26 180) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid c4044c85-0a52-570e-98ab-c3d95423c20e))
