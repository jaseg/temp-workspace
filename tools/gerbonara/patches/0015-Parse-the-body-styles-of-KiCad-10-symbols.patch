From c2b666868592e5180f0a07927e6da735cfb9c643 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:11:48 +0000
Subject: [PATCH 15/52] Parse the body styles of KiCad 10 symbols

KiCad 10 lists a symbol's body styles as (body_styles demorgan) or as
(body_styles "name" ...) for custom body styles.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index d0d77e5..5ba9405 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -519,6 +519,22 @@ class JumperPinGroups:
             yield [Atom.jumper_pin_groups, *(list(group) for group in value)]
 
 
+class BodyStyles:
+    """ KiCad 10's ``(body_styles ...)``: either the bare atom ``demorgan`` for a symbol with the classic De Morgan
+    alternate body, or the names of the symbol's custom body styles. Maps to a list of these, keeping atoms as atoms. """
+
+    def __atoms__(self):
+        return [Atom.body_styles]
+
+    def __map__(self, obj, parent=None):
+        _key, *styles = obj
+        return styles
+
+    def __sexp__(self, value):
+        if value:
+            yield [Atom.body_styles, *value]
+
+
 @sexp_type('power')
 class PowerSpec:
     """ Marks a symbol as a power symbol. KiCad 9 added local power symbols, whose net is local to their sheet. Their
@@ -536,6 +552,7 @@ class Symbol:
     raw_name: str = None
     extends: Named(str) = None
     power: PowerSpec = None
+    body_styles: BodyStyles() = None
     pin_numbers: OmitDefault(PinNumberSpec) = field(default_factory=PinNumberSpec)
     pin_names: OmitDefault(PinNameSpec) = field(default_factory=PinNameSpec)
     exclude_from_sim: OmitDefault(Named(YesNoAtom())) = False
