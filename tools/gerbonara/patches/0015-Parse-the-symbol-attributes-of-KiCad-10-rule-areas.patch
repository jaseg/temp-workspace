From 4a5b9395958f7fc32431ba4a0ae02b1517adb936 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:13:46 +0000
Subject: [PATCH 15/41] Parse the symbol attributes of KiCad 10 rule areas

KiCad 10 rule areas can override the DNP, simulation, BOM and board
attributes of the symbols inside them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py |  5 +++++
 tests/test_kicad_schematic.py        | 11 +++++++++++
 2 files changed, 16 insertions(+)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 8e53b5b..7e2f721 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -627,6 +627,11 @@ class Subsheet:
 
 @sexp_type('rule_area')
 class RuleArea:
+    # KiCad 10 lets rule areas set these attributes of the symbols inside them.
+    exclude_from_sim: Named(YesNoAtom()) = None
+    in_bom: Named(YesNoAtom()) = None
+    on_board: Named(YesNoAtom()) = None
+    dnp: Named(YesNoAtom()) = None
     polyline: Polyline = None
 
 
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 13e0b0b..7826c82 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -187,3 +187,14 @@ def test_text_color_and_href():
     text, = Schematic.parse(sch.serialize()).texts
     assert (text.effects.font.color.r, text.effects.font.color.a) == (255, 1)
     assert text.effects.href == 'https://example.com/docs'
+
+
+def test_rule_area_attributes():
+    sch = Schematic.parse('''(kicad_sch (version 20260306) (generator "eeschema")
+        (rule_area (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp yes)
+            (polyline (pts (xy 0 0) (xy 10 0) (xy 10 10) (xy 0 10)) (stroke (width 0) (type dash)) (fill (type none))
+                (uuid "d"))))''')
+    area, = sch.rule_areas
+    assert (area.exclude_from_sim, area.in_bom, area.dnp, len(area.polyline.points)) == (False, True, True, 4)
+    area, = Schematic.parse(sch.serialize()).rule_areas
+    assert (area.exclude_from_sim, area.in_bom, area.dnp, len(area.polyline.points)) == (False, True, True, 4)
-- 
