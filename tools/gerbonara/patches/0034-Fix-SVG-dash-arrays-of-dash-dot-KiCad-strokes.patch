From 0b351b53b7dccd8483893068f8e426a6e15ac52d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:14:24 +0000
Subject: [PATCH 34/41] Fix SVG dash arrays of dash-dot KiCad strokes

The dash-dot patterns were missing the comma between dash and gap, and
strokes of width 0, which KiCad draws at its default width, got all-zero
dashes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/base_types.py | 6 +++---
 tests/test_kicad_schematic.py         | 8 ++++++++
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/gerbonara/cad/kicad/base_types.py b/src/gerbonara/cad/kicad/base_types.py
index 3538603..95b0377 100644
--- a/src/gerbonara/cad/kicad/base_types.py
+++ b/src/gerbonara/cad/kicad/base_types.py
@@ -104,7 +104,7 @@ class Stroke:
             return default
     
     def svg_attrs(self, default_color=None):
-        w = self.width
+        w = self.width or 0.254
         if not (color := self.color or default_color):
             return {}
 
@@ -117,8 +117,8 @@ class Stroke:
             attrs['stroke_dasharray'] = {
                     Atom.dash: f'{w*5:.3f},{w*5:.3f}',
                     Atom.dot: f'{w*2:.3f},{w*2:.3f}',
-                    Atom.dash_dot: f'{w*5:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}',
-                    Atom.dash_dot_dot: f'{w*5:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}{w:.3f},{w*3:.3f}',
+                    Atom.dash_dot: f'{w*5:.3f},{w*3:.3f},{w:.3f},{w*3:.3f}',
+                    Atom.dash_dot_dot: f'{w*5:.3f},{w*3:.3f},{w:.3f},{w*3:.3f},{w:.3f},{w*3:.3f}',
                     }[self.type]
 
         return attrs
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index d06ff19..b51b421 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -343,3 +343,11 @@ def test_symbols_are_populated_by_default():
     assert sch.symbols[0].dnp is False
     from gerbonara.cad.kicad.schematic import SymbolInstance
     assert SymbolInstance().dnp is False
+
+
+@pytest.mark.parametrize('kind, n', [('dash', 2), ('dot', 2), ('dash_dot', 4), ('dash_dot_dot', 6)])
+def test_stroke_dasharray(kind, n):
+    from gerbonara.cad.kicad.base_types import Stroke
+    for width in (0, 0.3):
+        dashes = Stroke(width=width, type=Atom(kind)).svg_attrs('black')['stroke_dasharray'].split(',')
+        assert len(dashes) == n and all(float(d) > 0 for d in dashes)
-- 
