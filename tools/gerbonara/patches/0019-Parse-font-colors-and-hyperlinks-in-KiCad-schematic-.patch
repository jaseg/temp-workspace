From 672bbb36966d95fc49cf4fd824f4b06770ef717d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:13:37 +0000
Subject: [PATCH 19/52] Parse font colors and hyperlinks in KiCad schematic
 text

Schematic text can have its own color in (font ... (color r g b a)) and
a hyperlink in (effects ... (href "...")).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/base_types.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/gerbonara/cad/kicad/base_types.py b/src/gerbonara/cad/kicad/base_types.py
index 6a5d23e..f794ea9 100644
--- a/src/gerbonara/cad/kicad/base_types.py
+++ b/src/gerbonara/cad/kicad/base_types.py
@@ -372,6 +372,8 @@ class FontSpec:
     thickness: Named(float) = None
     bold: OmitDefault(Named(LegacyCompatibleFlag())) = False
     italic: OmitDefault(Named(LegacyCompatibleFlag())) = False
+    # Schematic text only
+    color: Color = None
     line_spacing: Named(float) = None
 
 
@@ -401,6 +403,8 @@ class TextEffect:
     font: FontSpec = field(default_factory=FontSpec)
     justify: OmitDefault(Justify) = field(default_factory=Justify)
     hide: OmitDefault(Named(LegacyCompatibleFlag())) = False
+    # Hyperlink of schematic text
+    href: Named(str) = None
 
 
 class TextMixin:
-- 
