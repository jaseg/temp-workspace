From 594f32ed6ddad88120fc702bc7d00993c8aef29e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:17:27 +0000
Subject: [PATCH 37/41] Make Symbol.resolve() work for KiCad symbol libraries

Symbol.resolve() looked the parent of a derived symbol up with
library[name], but neither Library nor the schematic's LocalLibrary
supported that. Both now look symbols up by their full name or their name
without library prefix, and resolve() prefers a parent from the same
library, since (extends ...) names have no prefix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py |  5 ++++-
 src/gerbonara/cad/kicad/symbols.py   | 27 ++++++++++++++++++++++++---
 tests/test_kicad_schematic.py        | 17 +++++++++++++++++
 3 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 7bfffe9..1fb61de 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -15,7 +15,7 @@ import warnings
 from .sexp import *
 from .base_types import *
 from .primitives import *
-from .symbols import Symbol
+from .symbols import Symbol, _lookup_symbol
 from . import graphical_primitives as gr
 
 from .. import primitives as cad_pr
@@ -747,6 +747,9 @@ class Table:
 class LocalLibrary:
     symbols: List(Symbol) = field(default_factory=list)
 
+    def __getitem__(self, name):
+        return _lookup_symbol(self.symbols, name)
+
 
 SUPPORTED_FILE_FORMAT_VERSIONS = [20230620]
 @sexp_type('kicad_sch')
diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index 437846b..ed4e28c 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -637,10 +637,17 @@ class Symbol:
             self.properties[name] = Property(name=name, value=value, id=i, effects=TextEffect(hide=hide))
 
     def resolve(self):
-        if self.extends:
-            return self.library[self.extends]
-        else:
+        """ The symbol this one is derived from with (extends ...), or this symbol itself. In libraries embedded in
+        schematics, names carry a library prefix, which `extends` leaves out; the parent is looked up in the same
+        library first. """
+        if not self.extends:
             return self
+        if self.library_name:
+            try:
+                return self.library[f'{self.library_name}:{self.extends}']
+            except KeyError:
+                pass
+        return self.library[self.extends]
 
     def is_graphic_symbol(self):
         return self.extends is None and (
@@ -683,6 +690,17 @@ class Symbol:
         return bool(self.get_center_rectangle(range(self.unit_count)))
 
 
+def _lookup_symbol(symbols, name):
+    """ Find a symbol by its full name (with library prefix, if it has one), else by its name alone. """
+    for sym in symbols:
+        if sym.raw_name == name:
+            return sym
+    for sym in symbols:
+        if sym.name == name:
+            return sym
+    raise KeyError(name)
+
+
 SUPPORTED_FILE_FORMAT_VERSIONS = [20211014, 20220914]
 @sexp_type('kicad_symbol_lib')
 class Library:
@@ -702,6 +720,9 @@ class Library:
         if value not in SUPPORTED_FILE_FORMAT_VERSIONS:
             raise FormatError(f'File format version {value} is not supported. Supported versions are {", ".join(map(str, SUPPORTED_FILE_FORMAT_VERSIONS))}.')
 
+    def __getitem__(self, name):
+        return _lookup_symbol(self.symbols, name)
+
     @classmethod
     def open(cls, filename: str):
         with open(filename) as f:
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 6e2c349..8ec2b66 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -373,3 +373,20 @@ def test_schematic_shapes_svg():
     assert area.attrs['d'].endswith(' Z')
     svg = str(sch.to_svg())
     assert svg.count('<path') == 4 and svg.count('<circle') == 1
+
+
+def test_derived_symbol_resolve():
+    sch = Schematic.parse('''(kicad_sch (version 20250114) (generator "eeschema")
+        (lib_symbols
+            (symbol "Device:R" (in_bom yes) (on_board yes)
+                (property "Reference" "R" (at 0 0 0) (effects (font (size 1.27 1.27))))
+                (symbol "R_0_1" (rectangle (start -1 -2) (end 1 2) (stroke (width 0)) (fill (type none)))))
+            (symbol "Device:R_Small" (extends "R")
+                (property "Reference" "R" (at 0 0 0) (effects (font (size 1.27 1.27)))))))''')
+    lib = sch.lib_symbols
+    assert lib['Device:R'] is lib['R']
+    small = lib['Device:R_Small']
+    assert small.resolve() is lib['Device:R']
+    assert lib['Device:R'].resolve() is lib['Device:R']
+    with pytest.raises(KeyError):
+        lib['Device:C']
