From 2cbac1bd6c98d1e1d513cfb751784956c1d2aebd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:12:49 +0000
Subject: [PATCH 29/41] Respect the pin name offset in the SVG export of KiCad
 pins

Pin names were always placed 0.2 mm beyond the pin's inner end. Use the
symbol's pin name offset instead, and for an offset of 0, which KiCad
uses for names outside the body, put the name above the middle of the pin
and the number below it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/symbols.py | 21 +++++++++++++--------
 tests/test_kicad_symbols.py        | 14 ++++++++++++++
 2 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/src/gerbonara/cad/kicad/symbols.py b/src/gerbonara/cad/kicad/symbols.py
index 9745aca..e8f5451 100644
--- a/src/gerbonara/cad/kicad/symbols.py
+++ b/src/gerbonara/cad/kicad/symbols.py
@@ -147,7 +147,12 @@ class Pin:
 
         rot = self.at.rotation + p_rotation
         trot = self.at.rotation
-        ax, ay = self.length+0.2, 0
+        # With a positive pin name offset, names go inside the body, that far beyond the pin's inner end. With an
+        # offset of 0, names go above the middle of the pin and numbers below it.
+        spec = self.unit.symbol.pin_names if self.unit is not None and self.unit.symbol is not None else None
+        offset = spec.offset if spec is not None and spec.offset is not None else 0.508
+        names_inside = offset > 0
+        ax, ay = (self.length + offset if names_inside else self.length/2), 0
         ax, ay = rotate_point(ax, ay, math.radians(-self.at.rotation))
 
         #lx, ly = self.at.x, -self.at.y
@@ -192,9 +197,9 @@ class Pin:
             yield font.render_svg(self.name.value,
                                   size=self.name.effects.font.size.y or 1.27,
                                   x0=0,
-                                  y0=0,
-                                  h_align=h_align,
-                                  v_align='middle',
+                                  y0=0 if names_inside else -0.4,
+                                  h_align=h_align if names_inside else 'center',
+                                  v_align='middle' if names_inside else 'bottom',
                                   rotation=-frot,
                                   stroke=colorscheme.pin_names,
                                   transform=f'translate({lx:.3f} {ly:.3f})',
@@ -205,10 +210,10 @@ class Pin:
         if self.number.value != '~' and not self.unit.symbol.pin_numbers.hide:
             yield font.render_svg(self.number.value,
                                   size=self.number.effects.font.size.y or 1.27,
-                                  x0=-0.4 if h_align == 'left' else 0.4,
-                                  y0=-0.4,
-                                  h_align={'left': 'right', 'right': 'left'}[h_align],
-                                  v_align='bottom',
+                                  x0=(-0.4 if h_align == 'left' else 0.4) if names_inside else 0,
+                                  y0=-0.4 if names_inside else 0.4,
+                                  h_align={'left': 'right', 'right': 'left'}[h_align] if names_inside else 'center',
+                                  v_align='bottom' if names_inside else 'top',
                                   rotation=-frot,
                                   stroke=colorscheme.pin_numbers,
                                   scale=(sx, sy),
diff --git a/tests/test_kicad_symbols.py b/tests/test_kicad_symbols.py
index a091938..c8ac125 100644
--- a/tests/test_kicad_symbols.py
+++ b/tests/test_kicad_symbols.py
@@ -228,3 +228,17 @@ def test_pin_bounding_box(rotation):
     # the box reaches past the pin's end, in the pin's direction
     assert x1 <= 0 <= x2 and y1 <= 0 <= y2
     assert (x2 if dx > 0 else -x1 if dx < 0 else y2 if dy > 0 else -y1) > 2.54
+
+
+@pytest.mark.parametrize('offset, name_x', [(0.508, -4.572), (0, -6.35)])
+def test_pin_name_offset(offset, name_x):
+    from gerbonara.cad.kicad.schematic import MirrorFlags
+    lib = Library.parse(f'''(kicad_symbol_lib (version 20241209) (generator "kicad_symbol_editor")
+        (symbol "Buf" (pin_names (offset {offset})) (in_bom yes) (on_board yes)
+            (symbol "Buf_1_1"
+                (pin input line (at -7.62 0 0) (length 2.54)
+                    (name "IN" (effects (font (size 1.27 1.27)))) (number "1" (effects (font (size 1.27 1.27))))))))''')
+    pin, = lib.symbols[0].units[0].pins
+    line, name, number = pin.to_svg(Colorscheme.KiCad, MirrorFlags(), 0)
+    x, y = map(float, re.match(r'translate\((\S+) (\S+)\)', name.attrs['transform']).groups())
+    assert (x, y) == pytest.approx((name_x, 0))
