{#- The plug on the end of a cable, at (x, y) pointing at `ang` degrees. `kind` is dupont, alligator or banana
    (housing in `color`), or stripped: `strands` [(y, dx, dy)] of bare copper out of a stub in `color`. #}
<g transform="translate({{ x|f }} {{ y|f }}) rotate({{ ang|f }})" stroke="{{ LINE }}" stroke-width=".3" stroke-linejoin="round">
{% if kind == 'dupont' %}
  <rect x="-.4" y="-1.4" width="6" height="2.8" rx=".4" fill="#6c5a7c"/>
  <rect x=".6" y="-.9" width="4" height=".5" fill="{{ color }}" stroke="none" opacity=".9"/>
  <rect x="5.6" y="-.32" width="2.6" height=".64" fill="#f3e6b8"/>
{% elif kind == 'alligator' %}
  <path d="M-.4 -1.5H3.6L5 -1V1L3.6 1.5H-.4Z" fill="{{ color }}"/>
  <path d="M5 -.9L10 -1.8 10.2 -.6 5 -.2Z" fill="#e3e0ea"/>
  <path d="M5 .9L10 1.8 10.2 .6 5 .2Z" fill="#e3e0ea"/>
  <path d="M6 -.9l.5 .4.5 -.55.5 .5.5 -.6.5 .5.5 -.65.5 .5M6 .9l.5 -.4.5 .55.5 -.5.5 .6.5 -.5.5 .65.5 -.5" fill="none" stroke-width=".18"/>
{% elif kind == 'banana' %}
  <path d="M-.4 -1.3H4.5Q5.5 -1.3 5.5 0Q5.5 1.3 4.5 1.3H-.4Z" fill="{{ color }}"/>
  <path d="M5.4 -.35H8Q8.8 -.7 9.4 -.35Q9.8 0 9.4 .35Q8.8 .7 8 .35H5.4Z" fill="#e3e0ea"/>
{% else %}
{% for sy, dx, dy in strands %}
  <path d="M1.2 {{ sy|f }}l{{ dx|f }} {{ dy|f }}" fill="none" stroke="#e7a36b" stroke-width=".22"/>
{% endfor %}
  <rect x="-.4" y="-.6" width="1.8" height="1.2" rx=".3" fill="{{ color }}"/>
{% endif %}
</g>
