From c1aa519c2289b036c2759fb2d1613dec476a612b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:13:12 +0000
Subject: [PATCH 35/52] Add size, bounding box and SVG export to KiCad images

Embedded images had no to_svg(), so exporting any schematic with an image
failed. Image.size gives the image's size in mm from its PNG header, at
300 dpi unless the PNG says otherwise, as KiCad does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 .../cad/kicad/graphical_primitives.py         | 46 ++++++++++++++++++-
 1 file changed, 45 insertions(+), 1 deletion(-)

diff --git a/src/gerbonara/cad/kicad/graphical_primitives.py b/src/gerbonara/cad/kicad/graphical_primitives.py
index 3f9241a..c6fb8da 100644
--- a/src/gerbonara/cad/kicad/graphical_primitives.py
+++ b/src/gerbonara/cad/kicad/graphical_primitives.py
@@ -2,6 +2,7 @@
 import string
 import math
 import base64
+import struct
 import textwrap
 
 from .sexp import *
@@ -11,7 +12,7 @@ from .primitives import *
 from ... import graphic_objects as go
 from ... import apertures as ap
 from ...newstroke import Newstroke
-from ...utils import rotate_point, MM, arc_bounds
+from ...utils import rotate_point, MM, arc_bounds, Tag
 
 @sexp_type('layer')
 class TextLayer:
@@ -367,6 +368,26 @@ class Base64Blob:
         yield [Atom.data, *textwrap.wrap(encoded, 76)]
 
 
+def png_size(data):
+    """ (width, height, dots per inch) of PNG data, or None if it is not PNG. The resolution comes from the pHYs chunk
+    and defaults to 300 dpi, like in KiCad. """
+    if data[:8] != b'\x89PNG\r\n\x1a\n':
+        return None
+    w, h = struct.unpack('>II', data[16:24])
+    dpi, pos = 300, 8
+    while pos + 8 <= len(data):
+        n, kind = struct.unpack('>I4s', data[pos:pos+8])
+        if kind == b'pHYs' and n >= 9:
+            ppu, _ppu_y, unit = struct.unpack('>IIB', data[pos+8:pos+17])
+            if unit == 1 and ppu: # pixels per meter
+                dpi = ppu * 0.0254
+            break
+        if kind == b'IDAT':
+            break
+        pos += 12 + n
+    return w, h, dpi
+
+
 @sexp_type('image')
 class Image:
     at: AtPos = field(default_factory=AtPos)
@@ -379,6 +400,29 @@ class Image:
     def offset(self, x=0, y=0):
         self.at = self.at.with_offset(x, y)
 
+    @property
+    def size(self):
+        """ (width, height) in mm with the image's scale applied, or None if the data is not a PNG image. """
+        if not (info := png_size(self.data or b'')):
+            return None
+        w, h, dpi = info
+        scale = self.scale or 1
+        return w / dpi * 25.4 * scale, h / dpi * 25.4 * scale
+
+    def bounding_box(self, default=None):
+        if not (size := self.size):
+            return default
+        w, h = size
+        return (self.at.x - w/2, self.at.y - h/2), (self.at.x + w/2, self.at.y + h/2)
+
+    def to_svg(self, colorscheme=None):
+        """ The image, centered on its position like KiCad draws it. """
+        if not (bbox := self.bounding_box()):
+            return
+        (x1, y1), (x2, y2) = bbox
+        yield Tag('image', x=f'{x1:.3f}', y=f'{y1:.3f}', width=f'{x2-x1:.3f}', height=f'{y2-y1:.3f}',
+                  href=f'data:image/png;base64,{base64.b64encode(self.data).decode()}')
+
 
 @sexp_type('dimension')
 class Dimension:
