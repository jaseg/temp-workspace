From 212232ed0a02de77c6aa49950018f8f08e3e4040 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:15:21 +0000
Subject: [PATCH 17/19] Parse tables in KiCad schematics

KiCad 8 added tables to schematics. Parse them with their cells, borders
and separators.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 52 ++++++++++++++++++++++++++++
 tests/test_kicad_schematic.py        | 19 ++++++++++
 2 files changed, 71 insertions(+)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index dfdc7df..f50e90b 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -652,6 +652,57 @@ class TextBox(TextMixin):
         yield from gr.TextBox.render(self, variables=variables)
 
 
+@sexp_type('border')
+class TableBorder:
+    external: Named(YesNoAtom()) = True
+    header: Named(YesNoAtom()) = True
+    stroke: Stroke = field(default_factory=Stroke)
+
+
+@sexp_type('separators')
+class TableSeparators:
+    rows: Named(YesNoAtom()) = True
+    cols: Named(YesNoAtom()) = True
+    stroke: Stroke = field(default_factory=Stroke)
+
+
+@sexp_type('span')
+class TableCellSpan:
+    columns: int = 1
+    rows: int = 1
+
+
+@sexp_type('table_cell')
+class TableCell:
+    text: str = ''
+    exclude_from_sim: Named(YesNoAtom()) = False
+    at: AtPos = field(default_factory=AtPos)
+    size: Rename(XYCoord) = field(default_factory=XYCoord)
+    margins: Margins = None
+    span: TableCellSpan = field(default_factory=TableCellSpan)
+    fill: OmitDefault(Fill) = None
+    effects: TextEffect = field(default_factory=TextEffect)
+    uuid: UUID = field(default_factory=UUID)
+
+
+@sexp_type('table')
+class Table:
+    """ A table of text cells. Cells are listed row by row, and cells covered by another cell's span are still listed
+    (with empty text). """
+    column_count: Named(int) = 1
+    border: TableBorder = field(default_factory=TableBorder)
+    separators: TableSeparators = field(default_factory=TableSeparators)
+    column_widths: Named(Array(float)) = field(default_factory=list)
+    row_heights: Named(Array(float)) = field(default_factory=list)
+    cells: Named(Array(TableCell)) = field(default_factory=list)
+    uuid: UUID = None
+
+    @property
+    def rows(self):
+        n = self.column_count
+        return [self.cells[i:i+n] for i in range(0, len(self.cells), n)]
+
+
 @sexp_type('lib_symbols')
 class LocalLibrary:
     symbols: List(Symbol) = field(default_factory=list)
@@ -687,6 +738,7 @@ class Schematic:
     beziers: List(Bezier) = field(default_factory=list)
     texts: List(Text) = field(default_factory=list)
     text_boxes: List(TextBox) = field(default_factory=list)
+    tables: List(Table) = field(default_factory=list)
     local_labels: List(LocalLabel) = field(default_factory=list)
     global_labels: List(GlobalLabel) = field(default_factory=list)
     hierarchical_labels: List(HierarchicalLabel) = field(default_factory=list)
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 753522d..a5264a4 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -207,3 +207,22 @@ def test_schematic_groups():
     assert (group.name, group.members) == ('GroupName', ['a', 'b'])
     group, = Schematic.parse(sch.serialize()).groups
     assert (group.name, group.members) == ('GroupName', ['a', 'b'])
+
+
+def test_schematic_tables():
+    cell = lambda text, x, y: f'''(table_cell "{text}" (exclude_from_sim no) (at {x} {y} 0) (size 20 5)
+        (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none))
+        (effects (font (size 1.27 1.27)) (justify left top)) (uuid "{text}"))'''
+    sch = Schematic.parse(f'''(kicad_sch (version 20250114) (generator "eeschema")
+        (table (column_count 2)
+            (border (external yes) (header yes) (stroke (width 0) (type solid)))
+            (separators (rows yes) (cols no) (stroke (width 0) (type solid)))
+            (column_widths 20 20) (row_heights 5 5)
+            (cells {cell("a", 10, 10)} {cell("b", 30, 10)} {cell("c", 10, 15)} {cell("d", 30, 15)})))''')
+    table, = sch.tables
+    assert (table.column_count, table.column_widths, table.separators.cols) == (2, [20, 20], False)
+    assert [[c.text for c in row] for row in table.rows] == [['a', 'b'], ['c', 'd']]
+    assert (table.cells[3].at.x, table.cells[3].size.y, table.cells[3].margins.left) == (30, 5, 0.9525)
+    table, = Schematic.parse(sch.serialize()).tables
+    assert [[c.text for c in row] for row in table.rows] == [['a', 'b'], ['c', 'd']]
+    assert (table.cells[0].span.columns, table.cells[0].span.rows) == (1, 1)
