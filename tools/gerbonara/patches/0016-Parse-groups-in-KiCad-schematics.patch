From f43204ce49ca26410e39e2037ed186cbd78f32a3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 21:14:17 +0000
Subject: [PATCH 16/41] Parse groups in KiCad schematics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 1 +
 tests/test_kicad_schematic.py        | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index 7e2f721..dfdc7df 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -692,6 +692,7 @@ class Schematic:
     hierarchical_labels: List(HierarchicalLabel) = field(default_factory=list)
     symbols: List(SymbolInstance) = field(default_factory=list)
     subsheets: List(Subsheet) = field(default_factory=list)
+    groups: List(Group) = field(default_factory=list)
     sheet_instances: Named(Array(SubsheetCrosslinkSheet)) = field(default_factory=list)
     symbol_instances: Named(Array(SymbolCrosslinkSheet)) = field(default_factory=list)
     embedded_fonts: Named(YesNoAtom()) = False
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index 7826c82..753522d 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -198,3 +198,12 @@ def test_rule_area_attributes():
     assert (area.exclude_from_sim, area.in_bom, area.dnp, len(area.polyline.points)) == (False, True, True, 4)
     area, = Schematic.parse(sch.serialize()).rule_areas
     assert (area.exclude_from_sim, area.in_bom, area.dnp, len(area.polyline.points)) == (False, True, True, 4)
+
+
+def test_schematic_groups():
+    sch = Schematic.parse('''(kicad_sch (version 20250114) (generator "eeschema")
+        (group "GroupName" (uuid "e") (members "a" "b")))''')
+    group, = sch.groups
+    assert (group.name, group.members) == ('GroupName', ['a', 'b'])
+    group, = Schematic.parse(sch.serialize()).groups
+    assert (group.name, group.members) == ('GroupName', ['a', 'b'])
-- 
