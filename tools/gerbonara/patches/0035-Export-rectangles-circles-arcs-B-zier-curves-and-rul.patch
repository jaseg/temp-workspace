+def test_schematic_shapes_svg():
+    sch = Schematic.parse('''(kicad_sch (version 20250114) (generator "eeschema")
+        (rectangle (start 0 0) (end 10 5) (stroke (width 0) (type dash)) (fill (type none)) (uuid "r"))
+        (circle (center 20 20) (radius 3) (stroke (width 0) (type default)) (fill (type background)) (uuid "c"))
+        (arc (start 1 0) (mid 0 1) (end -1 0) (stroke (width 0) (type default)) (fill (type none)) (uuid "a"))
+        (bezier (pts (xy 0 0) (xy 1 2) (xy 3 2) (xy 4 0)) (stroke (width 0) (type default)) (fill (type none)) (uuid "b"))
+        (rule_area (polyline (pts (xy 0 0) (xy 10 0) (xy 10 10)) (stroke (width 0) (type dash)) (fill (type none)) (uuid "p"))))''')
+    rect, = sch.rectangles[0].to_svg()
+    assert rect.attrs['d'] == 'M 0.000 0.000 H 10.000 V 5.000 H 0.000 Z' and 'stroke_dasharray' in rect.attrs
+    circle, = sch.circles[0].to_svg()
+    assert circle.name == 'circle' and circle.attrs['fill'] == Colorscheme.KiCad.fill
+    arc, = sch.arcs[0].to_svg()
+    assert arc.attrs['d'] == 'M 1.000 0.000 A 1.000 1.000 0 0 1 -1.000 0.000'
+    bezier, = sch.beziers[0].to_svg()
+    assert bezier.attrs['d'] == 'M 0.000 0.000 C 1.000 2.000 3.000 2.000 4.000 0.000'
+    area, = sch.rule_areas[0].to_svg()
+    assert area.attrs['d'].endswith(' Z')
+    svg = str(sch.to_svg())
+    assert svg.count('<path') == 4 and svg.count('<circle') == 1
