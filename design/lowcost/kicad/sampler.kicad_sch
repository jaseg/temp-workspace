  (hierarchical_label "VBIAS_A" (shape input) (at 132.08 63.5 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 13cdbf6b-4f20-5d4b-8c81-5ed1e56ee052))
