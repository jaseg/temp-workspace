// Level browser panel (levels.js).
diffEasy = #3cb371
diffNormal = #59b0f4
diffHard = #ff8c42
diffExpert = #e0475e
diffExpertPlus = #a66ff0
accent = #ff4fa3

#levelBrowser
  position fixed
  inset 0
  padding-top 48px // below the top bar (nav.styl)
  z-index 2147483000 // above the controls bar and its panels; the top bar is above this
  display flex
  flex-direction column
  background rgba(8, 10, 14, 0.94)
  color #e8ebef
  font 14px/1.4 'Segoe UI', system-ui, sans-serif

#levelBrowser[hidden]
  display none

#levelBrowser .lbHeader
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  width 100%
  max-width 960px
  margin 0 auto
  padding 12px 16px
  box-sizing border-box

#levelBrowser .lbTitle
  flex 1 1 auto
  margin 0
  font-size 20px
  font-weight 600
  white-space nowrap

#levelBrowser .lbCount
  color #8b93a0
  font-weight 400
  font-size 15px

#levelBrowser .lbSearch, #levelBrowser .lbSort
  height 34px
  padding 0 10px
  border 1px solid #2d333d
  border-radius 8px
  background #151920
  color inherit
  font inherit

#levelBrowser .lbSearch
  flex 1 1 220px
  min-width 0

#levelBrowser .lbSort:disabled
  opacity 0.5

#levelBrowser .lbTabs
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 6px
  width 100%

#levelBrowser .lbTab
  height 30px
  padding 0 12px
  border 0
  border-radius 15px
  background #232933
  color #b8bfca
  font inherit
  font-weight 600
  cursor pointer

  &[aria-selected='true']
    background #e8ebef
    color #111

#levelBrowser .lbTabHint
  margin-left 6px
  color #8b93a0
  font-size 12px

#levelBrowser .lbStatus
  max-width 960px
  margin 0 auto
  padding 24px 16px
  color #8b93a0

#levelBrowser .lbStatus[hidden]
  display none

#levelBrowser .lbList
  position relative // for the drop line while dragging
  flex 1 1 auto
  overflow-y auto
  width 100%
  max-width 960px
  margin 0 auto
  padding 0 16px 24px
  box-sizing border-box
  list-style none

#levelBrowser .lbLevel
  position relative
  display grid
  grid-template-columns 64px 1fr auto
  gap 4px 12px
  align-items center
  padding 10px
  border-radius 10px
  cursor pointer
  overflow hidden

  &:hover, &.expanded
    background #151920

#levelBrowser .lbHandle
  display none

#levelBrowser .lbList.reorder .lbLevel
  grid-template-columns 22px 64px 1fr auto

#levelBrowser .lbList.reorder .lbHandle
  display flex
  align-self stretch
  align-items center
  justify-content center
  margin -10px 0 -10px -10px
  color #5b6370
  font-size 18px
  touch-action none // the handle drags; it must not scroll the page on touch screens
  cursor not-allowed

  &::before
    content '⠿'

#levelBrowser .lbLevel.reorderable .lbHandle
  color #8b93a0
  cursor grab

  &:hover
    color #e8ebef

#levelBrowser .lbLevel.dragging
  z-index 1
  background #1d222b
  box-shadow 0 8px 24px rgba(0, 0, 0, 0.5)
  opacity 0.95
  cursor grabbing

  .lbHandle
    cursor grabbing

#levelBrowser .lbDropLine
  position absolute
  left 16px
  right 16px
  height 2px
  border-radius 1px
  background accent
  pointer-events none

#levelBrowser .lbCover
  width 64px
  height 64px
  border-radius 6px
  background #232933
  overflow hidden

  img
    width 100%
    height 100%
    object-fit cover

  img[hidden]
    display none

#levelBrowser .lbMain
  min-width 0

#levelBrowser .lbName
  font-weight 600
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

#levelBrowser .lbSub
  color #8b93a0
  font-weight 400

#levelBrowser .lbMeta
  color #a3abb7
  font-size 13px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

#levelBrowser .lbChips
  display flex
  flex-wrap wrap
  gap 4px
  margin-top 4px

#levelBrowser .lbChip, #levelBrowser .lbBadge, #levelBrowser .lbMore
  padding 1px 7px
  border-radius 10px
  font-size 12px
  font-weight 600
  white-space nowrap

#levelBrowser .lbChip
  background #232933

#levelBrowser .lbMore
  color #8b93a0
  font-weight 400

#levelBrowser .lbStars
  font-weight 400

#levelBrowser .lbBadge
  color #111
  background #8b93a0

  &.status3
    background #f5c542

  &.status2
    background #9bd2ff

#levelBrowser .dEasy
  color diffEasy

#levelBrowser .dNormal
  color diffNormal

#levelBrowser .dHard
  color diffHard

#levelBrowser .dExpert
  color diffExpert

#levelBrowser .dExpertPlus
  color diffExpertPlus

#levelBrowser .lbActions
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 6px
  max-width 200px

#levelBrowser .lbOrder
  display flex
  gap 4px
  width 100%
  justify-content flex-end

  &[hidden]
    display none

#levelBrowser .lbMove
  height 28px
  padding 0 9px
  border 0
  border-radius 6px
  background #232933
  color #e8ebef
  font inherit
  font-size 13px
  white-space nowrap
  cursor pointer

  &:hover:not(:disabled)
    background #2d333d

  &:disabled
    opacity 0.35
    cursor default

#levelBrowser .lbPlay, #levelBrowser .lbSuggest
  min-width 84px
  height 34px
  padding 0 12px
  border 0
  border-radius 17px
  font inherit
  font-weight 600
  white-space nowrap
  cursor pointer

  &:disabled
    cursor default
    opacity 0.5

  &[hidden]
    display none

#levelBrowser .lbPlay
  background accent
  color #fff

#levelBrowser .lbLevel.playing .lbPlay
  background #e8ebef
  color #111

#levelBrowser .lbSuggest
  background #232933
  color #e8ebef
  box-shadow inset 0 0 0 1px #3a414d

  &.on
    background rgba(255, 79, 163, 0.15)
    color accent
    box-shadow inset 0 0 0 1px accent

#levelBrowser .lbSuggested
  margin-top 4px
  color accent
  font-size 12px

  &[hidden]
    display none

#levelBrowser .lbLevel.loading .lbPlay
  animation lbPulse 0.8s ease-in-out infinite alternate

@keyframes lbPulse
  to
    opacity 0.4

#levelBrowser .lbProgress
  position absolute
  left 0
  bottom 0
  height 3px
  width 0
  background accent

#levelBrowser .lbDetails
  grid-column 1 / -1
  cursor default

#levelBrowser .lbDetails[hidden]
  display none

#levelBrowser .lbTableWrap
  overflow-x auto

#levelBrowser .lbTable
  border-collapse collapse
  width 100%
  font-size 13px
  font-variant-numeric tabular-nums
  white-space nowrap

  th, td
    padding 4px 8px
    text-align right
    border-bottom 1px solid #232933

  th:nth-child(-n+2), td:nth-child(-n+2)
    text-align left

  th
    color #8b93a0
    font-weight 400

#levelBrowser .lbNote
  margin-top 6px
  color #8b93a0
  font-size 12px

@media (max-width: 600px)
  #levelBrowser .lbActions
    flex-direction column
    align-items stretch

  #levelBrowser .lbMoveText
    display none

  #levelBrowser .lbMove
    flex 1
    padding 0 6px

  #levelBrowser .lbPlay, #levelBrowser .lbSuggest
    min-width 0
    height 30px
    padding 0 10px
    font-size 13px

  #levelBrowser .lbTabHint
    display none

@media (max-width: 480px)
  #levelBrowser .lbLevel
    grid-template-columns 48px 1fr auto
    padding 8px 4px

  #levelBrowser .lbList.reorder .lbLevel
    grid-template-columns 22px 48px 1fr auto

  #levelBrowser .lbList.reorder .lbHandle
    margin -8px 0 -8px -4px

  #levelBrowser .lbCover
    width 48px
    height 48px
