{#- A stack of books: `books` [(x, y, w, h, color, spines, shine_x, shine_y, shine_h)] are the covers (rects),
    the two spine lines (path `spines`) and a white shine strip; a heart on top at (heart_x, heart_y). #}
{% from 'drawings/wrap.svg.j2' import wrap %}
{% call wrap() %}
{% for x, y, w, h, color, spines, shine_x, shine_y, shine_h in books %}
<rect x="{{ x|f }}" y="{{ y|f }}" width="{{ w|f }}" height="{{ h|f }}" rx=".5" fill="{{ color }}"/>
<path d="{{ spines }}" fill="none" stroke-width=".25"/>
<rect x="{{ shine_x|f }}" y="{{ shine_y|f }}" width=".7" height="{{ shine_h|f }}" fill="#fff" stroke="none" opacity=".7"/>
{% endfor %}
<use href="#heart-d" transform="translate({{ heart_x|f }} {{ heart_y|f }}) scale(.16)" fill="#ff9cc2"/>
{% endcall %}
