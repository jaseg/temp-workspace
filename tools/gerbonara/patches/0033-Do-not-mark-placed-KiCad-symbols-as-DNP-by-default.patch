From 5567465740658b6aeacd75ff5ce83bf5ba6b6c43 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:13:59 +0000
Subject: [PATCH 33/41] Do not mark placed KiCad symbols as DNP by default

SymbolInstance.dnp defaulted to True, so every symbol from a KiCad 6
schematic, which has no (dnp ...) yet, and every newly created symbol
came out as do-not-populate.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013wvKon1yvwjNtAdtSuZzZh
---
 src/gerbonara/cad/kicad/schematic.py | 2 +-
 tests/test_kicad_schematic.py        | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/gerbonara/cad/kicad/schematic.py b/src/gerbonara/cad/kicad/schematic.py
index a37b370..441fe11 100644
--- a/src/gerbonara/cad/kicad/schematic.py
+++ b/src/gerbonara/cad/kicad/schematic.py
@@ -419,7 +419,7 @@ class SymbolInstance:
     in_bom: Named(YesNoAtom()) = True
     on_board: Named(YesNoAtom()) = True
     in_pos_files: Named(YesNoAtom()) = None
-    dnp: Named(YesNoAtom()) = True
+    dnp: Named(YesNoAtom()) = False
     fields_autoplaced: Named(YesNoAtom()) = True
     uuid: UUID = field(default_factory=UUID)
     default_instance: DefaultSymbolInstance = None
diff --git a/tests/test_kicad_schematic.py b/tests/test_kicad_schematic.py
index eb7d8a8..d06ff19 100644
--- a/tests/test_kicad_schematic.py
+++ b/tests/test_kicad_schematic.py
@@ -334,3 +334,12 @@ def test_page_size(paper, size):
     assert sch.page_settings.size == pytest.approx(size)
     w, h = map(float, re.search(r'viewBox="0 0 (\S+) (\S+)"', str(sch.to_svg())).groups())
     assert (w, h) == pytest.approx(size)
+
+
+def test_symbols_are_populated_by_default():
+    # KiCad 6 schematics have no (dnp ...) yet
+    sch = Schematic.parse('''(kicad_sch (version 20211123) (generator "eeschema")
+        (symbol (lib_id "Device:R") (at 10 10 0) (unit 1) (in_bom yes) (on_board yes)))''')
+    assert sch.symbols[0].dnp is False
+    from gerbonara.cad.kicad.schematic import SymbolInstance
+    assert SymbolInstance().dnp is False
